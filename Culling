task.spawn(function()
    while running do
        pcall(function()
            if not IsInGame() then
                inLobby = true
                GoToTeleporter()
                local remote = GetTeleportersRemote()
                if remote and currentTeleporter then
                    local tryStart = remote:FindFirstChild("TryToStart")
                    if tryStart and tryStart:IsA("RemoteEvent") then
                        pcall(function()
                            tryStart:FireServer(currentTeleporter)
                        end)
                    end
                    local start = remote:FindFirstChild("Start")
                    if start and start:IsA("RemoteEvent") then
                        pcall(function()
                            start:FireServer(currentTeleporter)
                        end)
                        startSent = true
                    end
                end
            else
                inLobby = false
            end
        end)
        task.wait(0.1)
    end
end)

