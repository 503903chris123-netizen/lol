--========================================================--
-- WAIT FOR ACTUAL TOWER
--========================================================--

local function WaitForTower(towerName, oldCount, timeout)
    local start = tick()

    while running and tick() - start < timeout do
        if GetTowerCount(towerName) > oldCount then
            return true
        end
        task.wait(0.05)
    end

    return false
end

--========================================================--
-- PLACE TOWER
--========================================================--

local function PlaceTower(key)
    local config

    for _, c in ipairs(TOWER_CONFIGS) do
        if c.key == key then
            config = c
            break
        end
    end

    if not config then
        return false
    end

    local currentCount =
        GetTowerCount(config.folderName)

    if currentCount >= config.max then
        return true
    end

    local uuid =
        GetTowerUUID(config.folderName)

    if not uuid then
        AddDebug(
            "无法获取 " ..
            config.folderName ..
            " UUID"
        )
        return false
    end

    local functions =
        ReplicatedStorage:FindFirstChild("Functions")

    if not functions then
        return false
    end

    local spawnTower =
        functions:FindFirstChild("SpawnNewTower")

    if not spawnTower then
        return false
    end

    local position =
        GetPlacementPosition()

    local success, result =
        pcall(function()
            return spawnTower:InvokeServer(
                uuid,
                position
            )
        end)

    if not success then
        AddDebug(
            config.folderName ..
            " Remote Error"
        )
        return false
    end

    -- 不相信 Remote 返回值
    -- 必须检查 Workspace.Towers

    if WaitForTower(
        config.folderName,
        currentCount,
        2
    ) then

        AddDebug(
            config.folderName ..
            " ACTUALLY PLACED"
        )

        return true
    end

    AddDebug(
        config.folderName ..
        " 放置后未检测到实际塔"
    )

    return false
end

--========================================================--
-- STRONGEST EMERGENCY
-- Gold > 2000 最高优先级
--========================================================--

local function TryStrongestImmediate()

    if strongestPlacing then
        return
    end

    -- 已经实际存在
    if GetTowerCount(
        "StrongestSorcererEvo"
    ) >= 1 then
        return
    end

    local Gold =
        LocalPlayer:FindFirstChild("Gold")

    if not Gold then
        return
    end

    local gold =
        tonumber(Gold.Value) or 0

    if gold <= 2000 then
        return
    end

    strongestPlacing = true

    AddDebug(
        "GOLD > 2000 !!!"
    )

    AddDebug(
        "STRONGEST IMMEDIATE"
    )

    -- 在实际检测到 Strongest 前持续尝试
    while running do

        if GetTowerCount(
            "StrongestSorcererEvo"
        ) >= 1 then

            AddDebug(
                "Strongest confirmed in Workspace.Towers"
            )

            break
        end

        local currentGold =
            tonumber(Gold.Value) or 0

        if currentGold <= 2000 then
            break
        end

        PlaceTower(
            "STRONGEST"
        )

        if GetTowerCount(
            "StrongestSorcererEvo"
        ) >= 1 then
            break
        end

        task.wait(0.05)
    end

    strongestPlacing = false
end

