local function UpdateStage()

    if not IsInGame() then

        stageBig.Text = "LOBBY"
        stageDesc.Text = "SEARCHING FOR TELEPORTER..."
        progress.Size = UDim2.new(0.05, 0, 1, 0)

        return
    end

    local colony =
        GetCurrentColony()

    if not colony then

        stageBig.Text = "LOADING"
        stageDesc.Text = "WAITING FOR MAP..."
        progress.Size = UDim2.new(0.15, 0, 1, 0)

        return
    end

    local harvester =
        GetTowerCount("HarvesterCurse")

    local miracle =
        GetTowerCount("MiracleSorcerer")

    local strongest =
        GetTowerCount("StrongestSorcererEvo")

    if harvester < 1 then

        stageBig.Text = "STAGE 0"
        stageDesc.Text = "DEPLOY HARVESTER CURSE"
        progress.Size = UDim2.new(0.15, 0, 1, 0)

    elseif miracle < 2 then

        stageBig.Text = "STAGE 0"
        stageDesc.Text = "DEPLOY MIRACLE SORCERER x2"
        progress.Size = UDim2.new(0.35, 0, 1, 0)

    elseif strongest < 1 then

        stageBig.Text = "STAGE 1"
        stageDesc.Text = "WAITING FOR GOLD > 2000 / STRONGEST"
        progress.Size = UDim2.new(0.65, 0, 1, 0)

    else

        stageBig.Text = "STAGE 1"
        stageDesc.Text = "FULL AUTOMATION ACTIVE"
        progress.Size = UDim2.new(1, 0, 1, 0)

    end
end

