local function UpdateStage()
    if not IsInGame() then
        stageBig.Text = "LOBBY"
        stageDesc.Text = "SEARCHING FOR TELEPORTER..."
        progress.Size = UDim2.new(0.05, 0, 1, 0)
        return
    end

    local colony = GetCurrentColony()
    if not colony then
        stageBig.Text = "LOADING"
        stageDesc.Text = "WAITING FOR MAP..."
        progress.Size = UDim2.new(0.15, 0, 1, 0)
        return
    end

    if currentStage == 0 then
        if colony == "Colony5" then
            stageBig.Text = "STAGE 0 (Colony5)"
            stageDesc.Text = "DEPLOY STRONGEST SORCERER"
        else
            stageBig.Text = "STAGE 0"
            stageDesc.Text = "DEPLOY HARVESTER CURSE"
        end
        progress.Size = UDim2.new(0.2, 0, 1, 0)
    elseif currentStage == 1 then
        if colony == "Colony5" then
            stageBig.Text = "STAGE 1 (Colony5)"
            stageDesc.Text = "DEPLOY HARVESTER CURSE"
        else
            stageBig.Text = "STAGE 1"
            stageDesc.Text = "BIND KOGANE TO HARVESTER"
        end
        progress.Size = UDim2.new(0.45, 0, 1, 0)
    elseif currentStage == 2 then
        if colony == "Colony5" then
            stageBig.Text = "STAGE 2 (Colony5)"
            stageDesc.Text = "BIND KOGANE TO STRONGEST"
        else
            stageBig.Text = "STAGE 2"
            stageDesc.Text = "DEPLOY JUSTICE SORCERER"
        end
        progress.Size = UDim2.new(0.65, 0, 1, 0)
    elseif currentStage == 3 then
        if colony == "Colony5" then
            stageBig.Text = "STAGE 3 (Colony5)"
            stageDesc.Text = "DEPLOY JUSTICE SORCERER"
        else
            stageBig.Text = "STAGE 3"
            stageDesc.Text = "FULL AUTOMATION ACTIVE"
        end
        progress.Size = UDim2.new(0.8, 0, 1, 0)
    elseif currentStage >= 4 then
        stageBig.Text = "STAGE 4 (Colony5)"
        stageDesc.Text = "DEPLOY AGENT SORCERER"
        progress.Size = UDim2.new(0.9, 0, 1, 0)
    end
end

