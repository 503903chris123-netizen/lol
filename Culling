local function AddDebug(message)
    table.insert(DebugMessages, 1, {
        time = os.date("%H:%M:%S"),
        text = tostring(message)
    })

    while #DebugMessages > MAX_DEBUG do
        table.remove(DebugMessages)
    end

    print("[NEXUS]", message)
end

