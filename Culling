--========================================================--
-- TOWER UUID
--========================================================--

local uuidCache = {}

local function GetUUIDByName(towerName)
    local remotes = GetRemotes()
    if not remotes then return nil end
    local remote = remotes:FindFirstChild("GetAllData")
    if not remote then return nil end

    local success, data = pcall(function()
        return remote:InvokeServer()
    end)

    if not success or not data or not data.Towers then
        return nil
    end

    for uuid, info in pairs(data.Towers) do
        if info and info.Name == towerName then
            return uuid
        end
    end

    return nil
end

local function GetTowerUUID(name)
    if uuidCache[name] then return uuidCache[name] end
    local uuid = GetUUIDByName(name)
    if uuid then uuidCache[name] = uuid end
    return uuid
end

