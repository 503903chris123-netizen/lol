--========================================================--
-- TELEPORTERS
--========================================================--

local function GetTeleporters()
    local folder = Workspace:FindFirstChild("CullingGamesTeleporters")
    if not folder then return {} end
    local result = {}
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("Model") then
            table.insert(result, child)
        end
    end
    table.sort(result, function(a, b)
        local aNum = tonumber(a.Name:match("%d+")) or 0
        local bNum = tonumber(b.Name:match("%d+")) or 0
        return aNum < bNum
    end)
    return result
end

local function IsTeleporterEmpty(tp)
    if not tp then return false end
    local config = tp:FindFirstChild("Config")
    if config then
        local playerCount = config:FindFirstChild("PlayerCount")
        if playerCount then
            return playerCount.Value == 0
        end
    end
    return true
end

local function GetTeleporterPlayerCount(tp)
    if not tp then return 0, 4 end
    local billboard = tp:FindFirstChild("Billboard")
    if not billboard then return 0, 4 end
    local gui = billboard:FindFirstChild("BillboardGui")
    if not gui then return 0, 4 end
    local label = gui:FindFirstChild("PlayerCount")
    if not label or not label:IsA("TextLabel") then return 0, 4 end
    local text = label.Text
    local count = tonumber(text:match("^(%d+)"))
    local max = tonumber(text:match("/(%d+)"))
    return count or 0, max or 4
end

local function GetNextEmptyTeleporter()
    local teleporters = GetTeleporters()
    if #teleporters == 0 then return nil end
    for i = 1, #teleporters do
        local index = ((lastTeleporterIndex + i - 1) % #teleporters) + 1
        local tp = teleporters[index]
        if IsTeleporterEmpty(tp) then
            lastTeleporterIndex = index
            return tp
        end
    end
    return nil
end

local function GoToTeleporter()
    local character = LocalPlayer.Character
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local tp = GetNextEmptyTeleporter()
    if not tp then return false end
    local teleports = tp:FindFirstChild("Teleports")
    if not teleports then return false end
    local entrance = teleports:FindFirstChild("Entrance")
    if not entrance then return false end
    root.CFrame = CFrame.new(entrance.Position + Vector3.new(0, 3, 0))
    currentTeleporter = tp
    return true
end

--========================================================--
-- REMOTE CONNECTION
--========================================================--

local connectedTeleportersRemote = nil

local function ConnectTeleportersRemote(remote)
    if not remote then return end
    if connectedTeleportersRemote == remote then return end
    connectedTeleportersRemote = remote
    AddDebug("Teleporters Remote connected")

    local host = remote:FindFirstChild("Host")
    local chooseStage = remote:FindFirstChild("ChooseStage")
    local startCountdown = remote:FindFirstChild("StartCountdown")
    local startRemote = remote:FindFirstChild("Start")
    local leave = remote:FindFirstChild("Leave")

    if host and host:IsA("RemoteEvent") then
        host.OnClientEvent:Connect(function(tp)
            if not running then return end
            currentTeleporter = tp
            task.wait(0.3)
            local r = GetTeleportersRemote()
            if not r then return end
            local choose = r:FindFirstChild("ChooseStage")
            if choose and choose:IsA("RemoteEvent") then
                pcall(function()
                    choose:FireServer(tp, false)
                end)
            end
        end)
    end

    if startCountdown and startCountdown:IsA("RemoteEvent") then
        startCountdown.OnClientEvent:Connect(function()
            if not running then return end
            if currentTeleporter then
                task.wait(0.2)
                local r = GetTeleportersRemote()
                if not r then return end
                local start = r:FindFirstChild("Start")
                if start and start:IsA("RemoteEvent") then
                    pcall(function()
                        start:FireServer(currentTeleporter)
                    end)
                    startSent = true
                end
            end
        end)
    end

    if leave and leave:IsA("RemoteEvent") then
        leave.OnClientEvent:Connect(function()
            if not running then return end
            currentTeleporter = nil
            startSent = false
        end)
    end
end

task.spawn(function()
    while running do
        local remote = GetTeleportersRemote()
        if remote then ConnectTeleportersRemote(remote) end
        task.wait(0.5)
    end
end)

