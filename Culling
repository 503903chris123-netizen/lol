local function UpdateUI()
    local inGame = IsInGame()
    local colony = GetCurrentColony()

    if colony then
        statusDot.BackgroundColor3 = GREEN
        statusText.Text = "SYSTEM ONLINE"
        statusText.TextColor3 = GREEN
    elseif inGame then
        statusDot.BackgroundColor3 = YELLOW
        statusText.Text = "LOADING WORLD"
        statusText.TextColor3 = YELLOW
    else
        statusDot.BackgroundColor3 = CYAN
        statusText.Text = "STANDBY"
        statusText.TextColor3 = CYAN
    end

    mapValue.Text = colony or "WAITING"
    mapValue.TextColor3 = colony and GREEN or YELLOW

    local character = LocalPlayer.Character
    playerValue.Text = character and character:FindFirstChild("HumanoidRootPart") and "READY" or "LOADING"
    playerValue.TextColor3 = character and GREEN or YELLOW

    remoteValue.Text = GetTeleportersRemote() and "CONNECTED" or "WAITING"
    remoteValue.TextColor3 = GetTeleportersRemote() and GREEN or YELLOW

    timerValue.Text = string.format("%02d:%02d", math.floor((tick() - StartTime) / 60), math.floor((tick() - StartTime) % 60))

    local tp = currentTeleporter
    teleporterValue.Text = tp and tp.Name or "--"

    for name, card in pairs(towerCards) do
        card.card.Visible = colony ~= nil

        if colony then
            local count = GetTowerCount(name)
            local max = card.info.max

            local levels = GetTowerLevels(name)

            card.count.Text = tostring(count) .. " / " .. tostring(max)

            if #levels > 0 then
                card.level.Text = "LEVEL  " .. table.concat(levels, "  /  ")
            else
                card.level.Text = "LEVEL  --"
            end

            local ratio = math.clamp(count / max, 0, 1)
            TweenService:Create(card.bar, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(ratio, 0, 1, 0)
            }):Play()

            if count >= max then
                card.state.Text = "ONLINE"
                card.state.TextColor3 = GREEN
            elseif count > 0 then
                card.state.Text = "ACTIVE"
                card.state.TextColor3 = CYAN
            else
                card.state.Text = "WAITING"
                card.state.TextColor3 = YELLOW
            end
        end
    end

    local lines = {}
    for i = 1, math.min(#DebugMessages, MAX_DEBUG) do
        local d = DebugMessages[i]
        table.insert(lines, "[" .. d.time .. "] " .. d.text)
    end
    debugLabel.Text = table.concat(lines, "\n")

    UpdateStage()
end

