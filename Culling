--========================================================--
-- UPGRADE
--========================================================--

function UpgradeLoop()

    if not upgradeEnabled then
        return
    end

    local towers =
        GetTowersFolder()

    if not towers then
        return
    end

    local functions =
        ReplicatedStorage:FindFirstChild(
            "Functions"
        )

    if not functions then
        return
    end

    local upgrade =
        functions:FindFirstChild(
            "UpgradeTower"
        )

    if not upgrade then
        return
    end

    for _, tower in ipairs(
        towers:GetChildren()
    ) do

        if not running then
            break
        end

        -- 只升级新塔
        local valid =
            tower.Name:sub(
                1,
                #"HarvesterCurse"
            ) == "HarvesterCurse"

            or tower.Name:sub(
                1,
                #"MiracleSorcerer"
            ) == "MiracleSorcerer"

            or tower.Name:sub(
                1,
                #"KingOfCursesEvo"
            ) == "KingOfCursesEvo"

            or tower.Name:sub(
                1,
                #"FrostBlossom"
            ) == "FrostBlossom"

            or tower.Name:sub(
                1,
                #"StrongestSorcererEvo"
            ) == "StrongestSorcererEvo"

        if valid then

            pcall(function()
                upgrade:InvokeServer(tower)
            end)

        end

        task.wait(0.05)
    end
end

