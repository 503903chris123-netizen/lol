--========================================================--
-- TOWER DETECTION (Workspace.Towers)
--========================================================--

local function GetTowersFolder()
    return Workspace:FindFirstChild("Towers")
end

local function GetTowersByName(name)
    local folder = GetTowersFolder()
    if not folder then return {} end
    local result = {}
    for _, tower in ipairs(folder:GetChildren()) do
        if tower.Name:sub(1, #name) == name then
            table.insert(result, tower)
        end
    end
    return result
end

local function GetTowerCount(name)
    return #GetTowersByName(name)
end

local function GetTowerLevel(tower)
    local level = tonumber(string.match(tower.Name, "%d+"))
    return level or 1
end

local function GetTowerLevels(name)
    local towers = GetTowersByName(name)
    local levels = {}
    for _, t in ipairs(towers) do
        table.insert(levels, GetTowerLevel(t))
    end
    table.sort(levels)
    return levels
end

