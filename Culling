--========================================================--
-- PLACE TOWER (支持自定义绑定目标)
--========================================================--

local function PlaceTower(key, bindTarget)
    local config
    for _, c in ipairs(TOWER_CONFIGS) do
        if c.key == key then
            config = c
            break
        end
    end
    if not config then return false end

    local uuid = GetTowerUUID(config.folderName)
    if not uuid then
        AddDebug("无法获取 " .. config.folderName .. " 的 UUID")
        return false
    end

    local functions = ReplicatedStorage:FindFirstChild("Functions")
    if not functions then return false end
    local spawnTower = functions:FindFirstChild("SpawnNewTower")
    if not spawnTower then return false end

    local position = GetPlacementPosition()

    if key == "KOGANE" then
        -- 如果传入了绑定目标，使用它；否则使用 HarvesterCurse
        local target = bindTarget
        if not target then
            local harvesters = GetTowersByName("HarvesterCurse")
            if #harvesters > 0 then
                target = harvesters[1]
            else
                AddDebug("Kogane: 找不到绑定目标 (HarvesterCurse)")
                return false
            end
        end
        local success, result = pcall(function()
            return spawnTower:InvokeServer(uuid, position, target)
        end)
        if success and result then
            AddDebug("Kogane 放置成功（绑定 " .. target.Name .. "）")
            return true
        else
            AddDebug("Kogane 放置失败")
            return false
        end
    else
        local success, result = pcall(function()
            return spawnTower:InvokeServer(uuid, position)
        end)
        if success and result then
            AddDebug(config.folderName .. " 放置成功")
            return true
        else
            AddDebug(config.folderName .. " 放置失败")
            return false
        end
    end
end

--========================================================--
-- UPGRADE
--========================================================--

local function UpgradeLoop()
    if not upgradeEnabled then return end

    local towers = GetTowersFolder()
    if not towers then return end

    local functions = ReplicatedStorage:FindFirstChild("Functions")
    if not functions then return end
    local upgrade = functions:FindFirstChild("UpgradeTower")
    if not upgrade then return end

    for _, tower in ipairs(towers:GetChildren()) do
        if not running then break end
        pcall(function()
            upgrade:InvokeServer(tower)
        end)
        task.wait(0.05)
    end
end

--========================================================--
-- TOWER LOGIC (根据地图调整阶段)
--========================================================--

task.spawn(function()
    while running do
        task.wait(0.3)

        pcall(function()
            local colony = GetCurrentColony()
            if not colony then
                currentStage = 0
                upgradeEnabled = false
                return
            end

            -- 计数
            local harvesterCount = GetTowerCount("HarvesterCurse")
            local koganeCount = GetTowerCount("Kogane")
            local justiceCount = GetTowerCount("JusticeSorcerer")
            local agentCount = GetTowerCount("SorcererAgent")
            local strongestCount = GetTowerCount("StrongestSorcererEvo")

            -- 判断是否为 Colony5（使用 Strongest 优先）
            local isColony5 = (colony == "Colony5")

            -- ===== 阶段管理 =====
            if currentStage == 0 then
                if isColony5 then
                    -- Colony5: 优先放置 Strongest
                    if strongestCount < 1 then
                        if PlaceTower("STRONGEST") then
                            AddDebug("StrongestSorcererEvo 已放置 (Colony5 优先)")
                        end
                    else
                        currentStage = 1
                        AddDebug("Stage 0 complete (Strongest placed)")
                    end
                else
                    -- 其他地图: 放置 Harvester
                    if harvesterCount < 1 then
                        if PlaceTower("HARVESTER") then
                            AddDebug("HarvesterCurse 已放置")
                        end
                    else
                        currentStage = 1
                        AddDebug("Stage 0 complete")
                    end
                end

            elseif currentStage == 1 then
                if isColony5 then
                    -- Colony5: 第二阶段放置 Harvester
                    if harvesterCount < 1 then
                        if PlaceTower("HARVESTER") then
                            AddDebug("HarvesterCurse 已放置 (Colony5)")
                        end
                    else
                        currentStage = 2
                        AddDebug("Stage 1 complete (Harvester placed)")
                    end
                else
                    -- 其他地图: 放置 Kogane（绑定 Harvester）
                    local harvesters = GetTowersByName("HarvesterCurse")
                    if #harvesters == 0 then
                        currentStage = 0
                        AddDebug("Harvester丢失，回到Stage 0")
                        return
                    end
                    if koganeCount < 1 then
                        if PlaceTower("KOGANE") then
                            AddDebug("Kogane 已放置 (绑定 Harvester)")
                        end
                    else
                        currentStage = 2
                        AddDebug("Stage 1 complete - 进入 Justice 阶段")
                    end
                end

            elseif currentStage == 2 then
                if isColony5 then
                    -- Colony5: 放置 Kogane（绑定 Strongest）
                    local strongests = GetTowersByName("StrongestSorcererEvo")
                    if #strongests == 0 then
                        currentStage = 0
                        AddDebug("Strongest丢失，回到Stage 0 (Colony5)")
                        return
                    end
                    if koganeCount < 1 then
                        if PlaceTower("KOGANE", strongests[1]) then
                            AddDebug("Kogane 已放置 (Colony5, 绑定 Strongest)")
                        end
                    else
                        currentStage = 3
                        AddDebug("Stage 2 complete - 进入 Justice 阶段")
                    end
                else
                    -- 其他地图: 放置 Justice
                    if justiceCount < 1 then
                        if PlaceTower("JUSTICE") then
                            AddDebug("JusticeSorcerer 已放置")
                        end
                    else
                        currentStage = 3
                        upgradeEnabled = true
                        AddDebug("Stage 2 complete - Justice 已就绪，升级开启")
                    end
                end

            elseif currentStage == 3 then
                if isColony5 then
                    -- Colony5: 放置 Justice
                    if justiceCount < 1 then
                        if PlaceTower("JUSTICE") then
                            AddDebug("JusticeSorcerer 已放置 (Colony5)")
                        end
                    else
                        currentStage = 4
                        upgradeEnabled = true
                        AddDebug("Stage 3 complete - Justice 已就绪，升级开启")
                    end
                else
                    -- 其他地图: 放置 Agent 和 Strongest（Strongest 在 Stage3 放）
                    if agentCount < 4 then
                        if PlaceTower("AGENT") then
                            AddDebug("放置 Agent")
                        end
                    end
                    if strongestCount < 1 then
                        if PlaceTower("STRONGEST") then
                            AddDebug("放置 StrongestSorcererEvo")
                        end
                    end
                end

            elseif currentStage == 4 and isColony5 then
                -- Colony5 最后放置 Agent
                if agentCount < 4 then
                    if PlaceTower("AGENT") then
                        AddDebug("放置 Agent (Colony5)")
                    end
                end
                -- 不增加 stage，保持 4，持续放置 Agent 直到满
            end

            -- 升级（阶段3及以上，或对于非Colony5为阶段2+）
            if upgradeEnabled then
                UpgradeLoop()
            end
        end)
    end
end)

