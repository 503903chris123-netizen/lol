--========================================================--
-- UUID CACHE
--========================================================--

local uuidCache = {}
local lastRefresh = 0

local function RefreshTowerData(force)

    local now = tick()

    if not force
        and now - lastRefresh < 3 then

        return next(uuidCache) ~= nil
    end

    local ok, data =
        pcall(function()

            return GetAllData:InvokeServer()

        end)

    if not ok
        or type(data) ~= "table"
        or type(data.Towers) ~= "table" then

        return false
    end

    lastRefresh = now

    local byName = {}

    for _, t in pairs(
        data.Towers
    ) do

        if type(t) == "table"
            and t.Name
            and t.UUID then

            local cur =
                byName[t.Name]

            if not cur
                or (
                    t.Equipped
                    and not cur.Equipped
                ) then

                byName[t.Name] = {

                    UUID = t.UUID,

                    Equipped =
                        t.Equipped
                        and true
                        or false
                }

            end
        end
    end

    for name, info in pairs(
        byName
    ) do

        uuidCache[name] =
            info.UUID

    end

    return true
end

local function ResolveUUID(towerName)

    if not uuidCache[towerName] then

        RefreshTowerData(true)

    end

    return uuidCache[towerName]
end

task.spawn(function()

    while not RefreshTowerData(true) do

        task.wait(1)

    end

end)

