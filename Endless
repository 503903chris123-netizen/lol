local currentMap = nil

--========================================================--
-- MAP
--========================================================--

local function DetectMap()

    local map =
        Workspace:FindFirstChild("Map")

    if not map then
        return nil
    end

    if map:FindFirstChild("Jogo") then

        return "Jogo"

    elseif map:FindFirstChild("JujutsuHigh") then

        return "JujutsuHigh"

    elseif map:FindFirstChild("Toji") then

        return "Toji"

    elseif map:FindFirstChild("Beach") then

        return "Beach"

    elseif map:FindFirstChild("Dagon") then

        return "Dagon"

    elseif map:FindFirstChild("Meguna") then

        return "Meguna"

    elseif map:FindFirstChild("Shibuya") then

        return "Shibuya"

    end

    return nil
end

local function IsInGame()

    return DetectMap() ~= nil

end

local function GetPositions()

    local detected =
        DetectMap()

    if detected then

        currentMap = detected

    end

    if not currentMap then
        return nil
    end

    return POSITIONS[currentMap]
end

--========================================================--
-- TOWER LEVEL
--========================================================--

local function GetTowerLevel(tower)

    local attr =
        tower:GetAttribute("Level")

    if typeof(attr) == "number" then
        return attr
    end

    local levelValue =
        tower:FindFirstChild("Level")
        or tower:FindFirstChild("level")

    if levelValue
        and tonumber(levelValue.Value) then

        return tonumber(
            levelValue.Value
        )
    end

    local level =
        tonumber(
            string.match(
                tower.Name,
                "%d+"
            )
        )

    return level or 1
end

--========================================================--
-- GET TOWERS
--========================================================--

local function GetTowersByName(name)

    local towers =
        Workspace:FindFirstChild("Towers")

    if not towers then
        return {}
    end

    local result = {}

    for _, t in ipairs(
        towers:GetChildren()
    ) do

        if t.Name:find(
            name,
            1,
            true
        ) then

            table.insert(
                result,
                t
            )

        end

    end

    return result
end

--========================================================--
-- MIRACLE CHECK
--========================================================--

local function AllMiracleAtLeast(level)

    local miracles =
        GetTowersByName(
            TOWER_NAMES.BASIC
        )

    if #miracles < 2 then
        return false
    end

    for _, t in ipairs(
        miracles
    ) do

        if GetTowerLevel(t) < level then

            return false

        end

    end

    return true
end

--========================================================--
-- FIND KING
--========================================================--

local function GetKingTower()

    local kings =
        GetTowersByName(
            TOWER_NAMES.KING
        )

    if #kings == 0 then
        return nil
    end

    return kings[1]
end

--========================================================--
-- PLACE TOWER
--========================================================--

local function PlaceTower(nameKey)

    if _G.stopAll then
        return false
    end

    local towerName =
        TOWER_NAMES[nameKey]

    if not towerName then
        return false
    end

    --====================================================--
    -- FrostBlossom
    -- 固定 UUID
    --====================================================--

    if nameKey == "FROST" then

        local args = {

            [1] =
                FROST_BLOSSOM_UUID,

            [2] =
                FROST_BLOSSOM_CFRAME

        }

        local ok, ret =
            pcall(function()

                return SpawnNewTower:InvokeServer(
                    unpack(args)
                )

            end)

        if ok and ret then

            _G.frostPlaced = true

            return true
        end

        return false
    end

    --====================================================--
    -- Kogane
    -- 固定 UUID
    -- 第三个参数绑定 KingOfCursesEvo
    --====================================================--

    if nameKey == "KOGANE" then

        local king =
            GetKingTower()

        if not king then
            return false
        end

        local args = {

            [1] =
                KOGANE_UUID,

            [2] =
                KOGANE_CFRAME,

            [3] =
                king

        }

        local ok, ret =
            pcall(function()

                return SpawnNewTower:InvokeServer(
                    unpack(args)
                )

            end)

        if not ok or not ret then
            return false
        end

        return true
    end

    --====================================================--
    -- 普通塔
    --====================================================--

    local posTable =
        GetPositions()

    if not posTable then
        return false
    end

    local pos =
        posTable[nameKey]

    if not pos then
        return false
    end

    local uuid =
        ResolveUUID(towerName)

    if not uuid then

        RefreshTowerData(true)

        uuid =
            ResolveUUID(towerName)

        if not uuid then
            return false
        end
    end

    local ok, ret =
        pcall(function()

            return SpawnNewTower:InvokeServer(
                uuid,
                pos
            )

        end)

    if not ok or not ret then

        uuidCache[towerName] = nil

        return false
    end

    task.spawn(function()

        task.wait(0.1)

        pcall(function()

            local towersFolder =
                Workspace:FindFirstChild(
                    "Towers"
                )

            if not towersFolder then
                return
            end

            for _, t in ipairs(
                towersFolder:GetChildren()
            ) do

                if t.Name:find(
                    towerName,
                    1,
                    true
                ) then

                    for i = 1, 3 do

                        ChangeTowerMode:InvokeServer(
                            t
                        )

                        task.wait(0.1)

                    end

                    break
                end

            end

        end)

    end)

    return true
end

--========================================================--
-- MIRACLE
--========================================================--

local function ProcessMiracle()

    if _G.stopAll then
        return
    end

    local miracles =
        GetTowersByName(
            TOWER_NAMES.BASIC
        )

    if #miracles < 2 then

        PlaceTower("BASIC")

        return
    end
end

--========================================================--
-- UPGRADE
--========================================================--

local function UpgradeLoop()

    if _G.stopAll then
        return
    end

    local towersFolder =
        Workspace:FindFirstChild(
            "Towers"
        )

    if not towersFolder then
        return
    end

    local miracles = {}

    for _, t in ipairs(
        towersFolder:GetChildren()
    ) do

        if t.Name:find(
            TOWER_NAMES.BASIC,
            1,
            true
        ) then

            table.insert(
                miracles,
                t
            )

        end

    end

    --==================================================--
    -- Miracle阶段
    --==================================================--

    if not _G.miraclePhaseComplete then

        if #miracles < 2 then
            return
        end

        table.sort(
            miracles,
            function(a, b)

                return GetTowerLevel(a)
                    < GetTowerLevel(b)

            end
        )

        for _, tower in ipairs(
            miracles
        ) do

            if GetTowerLevel(tower) < 4 then

                pcall(function()

                    UpgradeTower:InvokeServer(
                        tower
                    )

                end)

                return
            end

        end

        if AllMiracleAtLeast(4) then

            _G.miraclePhaseComplete =
                true

            print(
                "[系统] Miracle Phase 完成"
            )

        end

        return
    end

    --==================================================--
    -- 其他塔升级
    --==================================================--

    for _, tower in ipairs(
        towersFolder:GetChildren()
    ) do

        if not tower.Name:find(
            TOWER_NAMES.BASIC,
            1,
            true
        ) then

            local affected =

                tower.Name:find(
                    TOWER_NAMES.B85,
                    1,
                    true
                )

                or tower.Name:find(
                    TOWER_NAMES.GOJO,
                    1,
                    true
                )

                or tower.Name:find(
                    TOWER_NAMES.KING,
                    1,
                    true
                )

                or tower.Name:find(
                    TOWER_NAMES.HARVESTER,
                    1,
                    true
                )

                or tower.Name:find(
                    TOWER_NAMES.TREE,
                    1,
                    true
                )

                or tower.Name:find(
                    TOWER_NAMES.KOGANE,
                    1,
                    true
                )

            if not (
                _G.upgradeBlocked
                and affected
            ) then

                pcall(function()

                    UpgradeTower:InvokeServer(
                        tower
                    )

                end)

            end

        end

    end
end

task.spawn(function()

    while task.wait(0.3) do

        if IsInGame()
            and not _G.stopAll then

            pcall(
                UpgradeLoop
            )

        end

    end

end)

