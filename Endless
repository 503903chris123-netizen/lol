local MAX_PERFORMANCE = true

local function OptimizeObject(obj)

    if not MAX_PERFORMANCE then
        return
    end

    pcall(function()

        --================================================--
        -- PART
        --================================================--

        if obj:IsA("BasePart") then

            obj.Material =
                Enum.Material.SmoothPlastic

            obj.Reflectance = 0

            obj.CastShadow = false

            obj.MaterialVariant = ""

        end

        --================================================--
        -- MESH
        --================================================--

        if obj:IsA("SpecialMesh") then

            obj.TextureId = ""

        end

        --================================================--
        -- TEXTURE
        --================================================--

        if obj:IsA("Texture") then

            obj.Texture = ""

            obj.Transparency = 1

        end

        --================================================--
        -- DECAL
        --================================================--

        if obj:IsA("Decal") then

            obj.Texture = ""

            obj.Transparency = 1

        end

        --================================================--
        -- SURFACE APPEARANCE
        --================================================--

        if obj:IsA("SurfaceAppearance") then

            obj:Destroy()

            return

        end

        --================================================--
        -- PARTICLES
        --================================================--

        if obj:IsA("ParticleEmitter") then

            obj.Enabled = false
            obj.Rate = 0
            obj:Clear()

            obj:Destroy()

            return

        end

        --================================================--
        -- TRAIL
        --================================================--

        if obj:IsA("Trail") then

            obj.Enabled = false

            obj:Destroy()

            return

        end

        --================================================--
        -- BEAM
        --================================================--

        if obj:IsA("Beam") then

            obj.Enabled = false

            obj:Destroy()

            return

        end

        --================================================--
        -- SMOKE
        --================================================--

        if obj:IsA("Smoke") then

            obj.Enabled = false

            obj:Destroy()

            return

        end

        --================================================--
        -- FIRE
        --==================================================

        if obj:IsA("Fire") then

            obj.Enabled = false

            obj:Destroy()

            return

        end

        --================================================--
        -- SPARKLES
        --================================================--

        if obj:IsA("Sparkles") then

            obj.Enabled = false

            obj:Destroy()

            return

        end

        --================================================--
        -- HIGHLIGHT
        --================================================--

        if obj:IsA("Highlight") then

            obj.Enabled = false

            obj:Destroy()

            return

        end

        --================================================--
        -- LIGHT
        --================================================--

        if obj:IsA("PointLight")
            or obj:IsA("SpotLight")
            or obj:IsA("SurfaceLight") then

            obj.Enabled = false

            obj:Destroy()

            return

        end

    end)
end

