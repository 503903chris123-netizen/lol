local currentMap = nil

local function DetectMap()
    local map = Workspace:FindFirstChild("Map")
    if not map then return nil end
    if map:FindFirstChild("Jogo") then
        return "Jogo"
    elseif map:FindFirstChild("JujutsuHigh") then
        return "JujutsuHigh"
    elseif map:FindFirstChild("Toji") then
        return "Toji"
    elseif map:FindFirstChild("Beach") then
        return "Beach"
    elseif map:FindFirstChild("Dagon") then
        return "Dagon"
    elseif map:FindFirstChild("Meguna") then
        return "Meguna"
    end
    return nil
end

local function IsInGame()
    return DetectMap() ~= nil
end

local function GetPositions()
    if not currentMap then
        currentMap = DetectMap()
    end
    return POSITIONS[currentMap]
end

local function GetTowerLevel(tower)
    local level = tonumber(string.match(tower.Name, "%d+"))
    return level or 1
end

local function GetTowersByName(name)
    local towers = Workspace:FindFirstChild("Towers")
    if not towers then return {} end
    local result = {}
    for _, t in ipairs(towers:GetChildren()) do
        if t.Name:find(name) then
            table.insert(result, t)
        end
    end
    return result
end

local function AllMiracleAtLeast(level)
    local miracles = GetTowersByName(TOWER_NAMES.BASIC)
    if #miracles < 2 then return false end
    for _, t in ipairs(miracles) do
        if GetTowerLevel(t) < level then
            return false
        end
    end
    return true
end

