local function UpdateUI()
    if not IsInGame() then
        stageLabel.Text = "等待进入游戏..."
        return
    end

    local timer = Workspace:FindFirstChild("Info") and Workspace.Info:FindFirstChild("Time") and Workspace.Info.Time:FindFirstChild("Timer")
    if timer then
        timeLabel.Text = tostring(timer.Value)
    end

    local miracles = GetTowersByName(TOWER_NAMES.BASIC)
    local agents = GetTowersByName(TOWER_NAMES.CHEAP)
    local gojos = GetTowersByName(TOWER_NAMES.GOJO)
    local kings = GetTowersByName(TOWER_NAMES.KING)
    local b85s = GetTowersByName(TOWER_NAMES.B85)

    local function getLevels(towers)
        local levels = {}
        for _, t in ipairs(towers) do
            table.insert(levels, GetTowerLevel(t))
        end
        table.sort(levels)
        return levels
    end

    local mLevels = getLevels(miracles)
    local aLevels = getLevels(agents)
    local gLevels = getLevels(gojos)
    local kLevels = getLevels(kings)
    local bLevels = getLevels(b85s)

    local function formatDetail(count, levels, target, extra)
        local levelStr = (#levels > 0) and table.concat(levels, "、") or "无"
        return string.format("数量:%d / %d\n等级:%s\n%s", count, target, levelStr, extra or "")
    end

    cards.Miracle.detail.Text = formatDetail(#miracles, mLevels, 2, _G.miraclePhaseComplete and "✓ 完成" or "阶段1")
    cards.Miracle.next.Text = _G.miraclePhaseComplete and "完成" or (#miracles < 2 and "放置" or "升级")

    cards.Agent.detail.Text = formatDetail(#agents, aLevels, 4, _G.miraclePhaseComplete and _G.frostPlaced and "可放置" or "等待")
    cards.Agent.next.Text = (_G.miraclePhaseComplete and _G.frostPlaced) and (#agents < 4 and "放置" or "升级") or "等待"

    cards.Gojo.detail.Text = formatDetail(#gojos, gLevels, 1, _G.miraclePhaseComplete and _G.frostPlaced and "可放置" or "等待")
    cards.Gojo.next.Text = (_G.miraclePhaseComplete and _G.frostPlaced) and (#gojos == 0 and "放置" or "已放置") or "等待"

    cards.King.detail.Text = formatDetail(#kings, kLevels, 1, _G.miraclePhaseComplete and _G.frostPlaced and "可放置" or "等待")
    cards.King.next.Text = (_G.miraclePhaseComplete and _G.frostPlaced) and (#kings == 0 and "放置" or "已放置") or "等待"

    cards.Red.detail.Text = formatDetail(#b85s, bLevels, 1, "不升级")
    cards.Red.next.Text = _G.frostPlaced and "已放置" or "优先放置"

    local phaseText = ""
    if _G.stopAll then
        phaseText = "⛔ 已停止 - Wave 50+"
    elseif not _G.miraclePhaseComplete then
        phaseText = "阶段1: 奇迹建造"
    elseif not _G.frostPlaced then
        phaseText = "阶段2: 放置冰冻宿傩"
    else
        phaseText = "阶段3: 全面部署"
    end
    stageLabel.Text = phaseText

    scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 15)
end

