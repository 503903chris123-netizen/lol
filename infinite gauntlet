local function CheckSnail()
    local mobs = Workspace:FindFirstChild("Mobs")
    if mobs then
        local snail = mobs:FindFirstChild("ImmortalSnail")
        if snail then
            _G.snailPresent = true
            _G.upgradeBlocked = true
            return true
        end
    end
    _G.snailPresent = false
    _G.upgradeBlocked = false
    return false
end

-- ==================== 升级函数 ====================
local function UpgradeLoop()
    if _G.stopAll then return end
    
    local towersFolder = Workspace:FindFirstChild("Towers")
    if not towersFolder then return end

    local miracles = {}
    local others = {} -- 存储所有非奇迹塔
    for _, t in ipairs(towersFolder:GetChildren()) do
        if t.Name:find(TOWER_NAMES.BASIC) then
            table.insert(miracles, t)
        else
            table.insert(others, t)
        end
    end

    -- 第一步：奇迹升级（始终优先，不受snail影响）
    if not _G.miraclePhaseComplete then
        if #miracles < 2 then
            for _, t in ipairs(miracles) do
                if GetTowerLevel(t) < 4 then
                    pcall(function() UpgradeTower:InvokeServer(t) end)
                    return
                end
            end
            return
        end
        table.sort(miracles, function(a, b) return GetTowerLevel(a) < GetTowerLevel(b) end)

        for _, t in ipairs(miracles) do
            if GetTowerLevel(t) < 2 then
                pcall(function() UpgradeTower:InvokeServer(t) end)
                return
            end
        end
        for _, t in ipairs(miracles) do
            if GetTowerLevel(t) < 4 then
                pcall(function() UpgradeTower:InvokeServer(t) end)
                return
            end
        end
        if AllMiracleAtLeast(4) then
            _G.miraclePhaseComplete = true
            print("[系统] 奇迹阶段完成")
        end
        return
    end

    -- 第二步：奇迹完成，升级其他塔
    for _, t in ipairs(others) do
        local id = t.Name:match("^[^%d]+") -- 获取纯名称（去掉数字等级后缀）
        -- 判断是否为三个受snail影响的塔
        local isSnailAffected = (string.find(t.Name, TOWER_NAMES.B85) or 
                                 string.find(t.Name, TOWER_NAMES.GOJO) or 
                                 string.find(t.Name, TOWER_NAMES.KING))
        
        -- 如果snail存在且该塔受snail影响，则跳过升级
        if _G.upgradeBlocked and isSnailAffected then
            continue
        end
        
        -- 否则正常升级（所有其他塔，包括特工和未受影响的）
        pcall(function() UpgradeTower:InvokeServer(t) end)
        task.wait(0.05) -- 避免请求过快
    end
end

task.spawn(function()
    while task.wait(0.3) do
        if IsInGame() and not _G.stopAll then
            pcall(UpgradeLoop)
        end
    end
end)

