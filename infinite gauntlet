-- ==================== 获取当前波数 ====================
local function GetWave()
    local info = Workspace:FindFirstChild("Info")
    if not info then return 0 end
    local wave = info:FindFirstChild("Wave")
    if not wave or not wave:IsA("ValueBase") then return 0 end
    return wave.Value or 0
end

-- ==================== 获取Meguna地图中B85的放置坐标 ====================
local function GetB85Position()
    if currentMap ~= "Meguna" then
        -- 非Meguna地图，直接从POSITIONS取B85
        local pos = POSITIONS[currentMap]
        return pos and pos.B85
    end
    -- Meguna地图：10波前用早期坐标，10波后用最终坐标
    local wave = GetWave()
    if wave < 10 then
        return POSITIONS.Meguna.B85_EARLY
    else
        return POSITIONS.Meguna.B85_FINAL
    end
end

-- ==================== B85迁移检测 ====================
local function CheckB85Migration()
    if currentMap ~= "Meguna" then return end
    if _G.b85Moved then return end
    local wave = GetWave()
    if wave >= 10 then
        -- 卖掉现有的B85，并在新坐标放置
        local towersFolder = Workspace:FindFirstChild("Towers")
        if towersFolder then
            local oldB85 = nil
            for _, t in ipairs(towersFolder:GetChildren()) do
                if t.Name:find(TOWER_NAMES.B85) then
                    oldB85 = t
                    break
                end
            end
            if oldB85 then
                pcall(function()
                    SellTower:InvokeServer(oldB85)
                    print("[系统] 卖掉10波前的冰冻宿傩")
                end)
                task.wait(0.2)
                -- 放置新B85到最终坐标
                local pos = POSITIONS.Meguna.B85_FINAL
                local u = ResolveUUID(TOWER_NAMES.B85)
                if u then
                    pcall(function()
                        SpawnNewTower:InvokeServer(u, pos)
                        print("[系统] 在最终位置放置冰冻宿傩")
                    end)
                end
                _G.b85Moved = true
                -- 更新frostPlaced标志，以免ProcessFlow再次尝试放置
                _G.frostPlaced = true
            end
        end
    end
end

-- ==================== 放置函数（修改为支持动态坐标） ====================
local function PlaceTower(nameKey)
    if _G.stopAll then return false end
    local towerName = TOWER_NAMES[nameKey]
    if not towerName then return false end
    local posTable = GetPositions()
    if not posTable then return false end
    
    local pos
    if nameKey == "B85" and currentMap == "Meguna" then
        -- B85使用动态坐标
        pos = GetB85Position()
    else
        pos = posTable[nameKey]
    end
    
    if not pos then return false end
    local u = ResolveUUID(towerName)
    if not u then return false end
    local ok, ret = pcall(function()
        return SpawnNewTower:InvokeServer(u, pos)
    end)
    if not (ok and ret) then
        if uuidCache[towerName] then
            uuidCache[towerName] = nil
            RefreshTowerData()
        end
        return false
    end
    
    if nameKey == "KING" then
        _G.kingPlaced = true
        print("[系统] King已放置")
    end
    
    -- 放置成功后，调用 ChangeTowerMode 3次
    task.spawn(function()
        pcall(function()
            local towersFolder = Workspace:FindFirstChild("Towers")
            if towersFolder then
                for _, t in ipairs(towersFolder:GetChildren()) do
                    if t.Name:find(towerName) then
                        for i = 1, 3 do
                            ChangeTowerMode:InvokeServer(t)
                            task.wait(0.1)
                        end
                        break
                    end
                end
            end
        end)
    end)
    
    return true
end

