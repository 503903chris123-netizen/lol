local function ProcessFlow()
    if _G.stopAll then return end
    if not IsInGame() then return end

    if environment.Stage == 0 then
        PlaceTower("BASIC")
        task.wait(0.1)
        PlaceTower("BASIC")
        environment.Stage = 1
        return
    end

    if not _G.miraclePhaseComplete then
        return
    end

    -- 放置B85（但如果已经迁移过且处于Meguna地图，可能已经放置了最终B85，但此处避免重复放置）
    if not _G.frostPlaced then
        -- 检查是否已存在B85（无论哪个位置）
        local b85s = GetTowersByName(TOWER_NAMES.B85)
        if #b85s < 1 then
            PlaceTower("B85")
            task.wait(0.1)
        else
            _G.frostPlaced = true
            print("[系统] 冰冻宿傩已放置")
        end
        return
    end

    local agents = GetTowersByName(TOWER_NAMES.CHEAP)
    local gojos = GetTowersByName(TOWER_NAMES.GOJO)
    local kings = GetTowersByName(TOWER_NAMES.KING)

    if #agents < 4 then
        PlaceTower("CHEAP")
        task.wait(0.1)
    end

    if #gojos < 1 then
        PlaceTower("GOJO")
        task.wait(0.1)
    end

    if #kings < 1 and not _G.kingPlaced then
        PlaceTower("KING")
        task.wait(0.1)
    end

    local miracles = GetTowersByName(TOWER_NAMES.BASIC)
    if #miracles < 2 and Gold.Value >= 300 then
        PlaceTower("BASIC")
    end
end

