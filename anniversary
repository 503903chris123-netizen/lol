local uiOk, uiErr = pcall(function()
	local TweenService = game:GetService("TweenService")
	local UserInputService = game:GetService("UserInputService")

	local COLORS = {
		bg      = Color3.fromRGB(11, 11, 15),
		surface = Color3.fromRGB(18, 18, 24),
		tile    = Color3.fromRGB(24, 24, 32),
		line    = Color3.fromRGB(38, 38, 50),
		text    = Color3.fromRGB(240, 240, 246),
		sub     = Color3.fromRGB(128, 128, 148),
		dim     = Color3.fromRGB(82, 82, 100),
		green   = Color3.fromRGB(52, 211, 153),
		amber   = Color3.fromRGB(251, 191, 36),
		gray    = Color3.fromRGB(100, 100, 120),
		accent  = Color3.fromRGB(139, 128, 255),
	}

	local function New(class, props, parent)
		local obj = Instance.new(class)
		for k, v in pairs(props) do obj[k] = v end
		if parent then obj.Parent = parent end
		return obj
	end

	local function Corner(parent, r) return New("UICorner", { CornerRadius = UDim.new(0, r) }, parent) end

	local function Stroke(parent, color, thickness, transparency)
		return New("UIStroke", {
			Color = color, Thickness = thickness or 1, Transparency = transparency or 0,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, parent)
	end

	local function Label(parent, text, size, color, font, xalign)
		return New("TextLabel", {
			BackgroundTransparency = 1, Text = text, TextSize = size, TextColor3 = color,
			Font = font or Enum.Font.GothamMedium,
			TextXAlignment = xalign or Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
		}, parent)
	end

	local function Tween(obj, props, t)
		pcall(function()
			TweenService:Create(obj, TweenInfo.new(t or 0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props):Play()
		end)
	end

	local function GetGuiParent()
		local ok, g = pcall(function() return gethui and gethui() end)
		if ok and g then return g end
