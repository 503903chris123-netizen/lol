local jjhLastTry, jjhFails = {}, {}

local function JJHPlace(key)
	if JJH.stopAll or not jjhLoaded then return false end

	local towerName = JJH_TOWERS[key]
	if JJH_FARM[key] and key ~= jjhFarmKey then return false end

	-- Gojo 要等 King 先放下 (King 有 uuid 才等)
	if key == "GOJO" and jjhUUID.KING and #JJHTowers(JJH_TOWERS.KING) == 0 then return false end

	if #JJHTowers(towerName) >= (JJH_TARGET[key] or 1) then return false end

	-- 放不了的 (没带 / 钱不够) 连续失败多次后退避
	local interval = ((jjhFails[key] or 0) >= 5) and 5 or 0.5
	if tick() - (jjhLastTry[key] or 0) < interval then return false end
	jjhLastTry[key] = tick()

	local uuid = JJH_FARM[key] and JJHFarmUUID() or jjhUUID[key]
	local pos = JJH_POS[key]
	if not uuid or not pos then return false end

	local ok, ret
	if key == "KOGANE" then
		local king = JJHTowers(JJH_TOWERS.KING)[1]
		if not king then return false end
		ok, ret = pcall(function() return SpawnNewTower:InvokeServer(uuid, pos, king) end)
	else
		ok, ret = pcall(function() return SpawnNewTower:InvokeServer(uuid, pos) end)
	end

	if ok and ret then
		jjhFails[key] = 0
		return true
	end
	jjhFails[key] = (jjhFails[key] or 0) + 1
	return false
end

