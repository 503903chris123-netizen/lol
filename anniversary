local function NameMatches(instName, base)
	local n = string.lower(tostring(instName))
	local b = string.lower(base)
	if string.sub(n, 1, #b) ~= b then return false end
	return string.match(string.sub(n, #b + 1), "^[%s%d_%-%.%(%)]*$") ~= nil
end

local function DataNameMatches(base, name)
	if base == AMPLIFYING then
		return string.find(string.lower(tostring(name)), "amplif", 1, true) ~= nil
	end
	return NameMatches(name, base)
end

local function StripNumber(name)
	local base = string.gsub(tostring(name), "[%s_%-%.]*%d+$", "")
	return base
end

-- 场上的塔实例是否属于这个塔名
local function InstMatches(instName, base)
	if base == AMPLIFYING then
		return string.find(string.lower(tostring(instName)), "amplif", 1, true) ~= nil
	end
	return NameMatches(instName, realName[base] or base)
end

--========================================================--
-- 自己的塔列表 (Registry): 只有进了这个列表的塔才会被放置判断 / 升级 / 删除 / 开领域用到
--   进列表的条件:
--     1) Tower.Config.Owner 是自己 (ObjectValue / 属性 / 名字 / UserId 都认)
--     2) Owner 读不到时: 房间里只有自己, 或者刚发出放置请求 (3 秒内) 出现的同名新塔
--     3) SpawnNewTower 直接返回了塔实例
--   Owner 明确是别人的塔永远不会进列表
--========================================================--

local Registry = {}      -- [塔实例] = true
local pendingPlace = {}  -- [基础塔名] = 发出放置请求的时间

local ownerLogged = false

-- 返回 true (是我的) / false (是别人的) / nil (读不到)
local function OwnerState(tower)
	if not tower then return false end

	local cfg = tower:FindFirstChild("Config")
	local owner = cfg and cfg:FindFirstChild("Owner")

	local v
	if owner then
		local ok, val = pcall(function() return owner.Value end)
		if ok then v = val end
	else
		local ok, a = pcall(function() return tower:GetAttribute("Owner") end)
		if ok then v = a end
	end

	if v == nil then return nil end

	if not ownerLogged then
		ownerLogged = true
		print("[PinataStarter] Owner 类型 = " .. typeof(v) .. ", 值 = " .. tostring(v))
	end

	local t = typeof(v)
	if t == "Instance" then return v == LocalPlayer end
	if t == "number" then return v == LocalPlayer.UserId end
	if t == "string" then
		return v == LocalPlayer.Name or v == LocalPlayer.DisplayName or v == tostring(LocalPlayer.UserId)
	end
	return false
end

-- 发出放置请求之后调用: 记下时间, 让新出现的同名塔能被登记; 返回值是塔实例就直接登记
local function NotePlaced(base, ret)
	pendingPlace[base] = tick()
	if typeof(ret) == "Instance" and ret.Parent and OwnerState(ret) ~= false then
		Registry[ret] = true
		pendingPlace[base] = nil
	end
end

local function ClaimPending(inst)
	for base, t in pairs(pendingPlace) do
		if tick() - t < 3 and InstMatches(inst.Name, base) then
			pendingPlace[base] = nil
			return true
		end
	end
	return false
end

local function ScanTowers()
	for inst in pairs(Registry) do
		if not inst.Parent then Registry[inst] = nil end
	end

	local folder = Workspace:FindFirstChild("Towers")
	if not folder then return end

	for _, t in ipairs(folder:GetChildren()) do
		if not Registry[t] then
			local st = OwnerState(t)
			if st == true then
				Registry[t] = true
			elseif st == nil then
				if #Players:GetPlayers() <= 1 or ClaimPending(t) then
					Registry[t] = true
				end
			end
		end
	end
end

task.spawn(function()
	while task.wait(0.1) do
		pcall(ScanTowers)
	end
end)

-- 自己的所有塔 (来自列表)
local function MyTowers()
	local list = {}
	for inst in pairs(Registry) do
		if inst.Parent then table.insert(list, inst) end
	end
	return list
end

local uuidByName = {}   -- [塔名] = uuid
local lastData = 0

local function RefreshUUIDs()
	if tick() - lastData < 3 then return end
	lastData = tick()

	local ok, data = pcall(function() return GetAllData:InvokeServer() end)
	if not ok or type(data) ~= "table" or type(data.Towers) ~= "table" then return end

	local hasFlag = false
	for _, t in pairs(data.Towers) do
		if type(t) == "table" and t.Equipped ~= nil then hasFlag = true break end
	end

	for _, g in ipairs(GROUPS) do
		for _, base in ipairs(g.towers) do
			local found, foundEquipped, foundName
			for _, t in pairs(data.Towers) do
				if type(t) == "table" and t.Name and t.UUID and DataNameMatches(base, t.Name) then
					local isEq = (not hasFlag) or (t.Equipped == true)
					if not found or (isEq and not foundEquipped) then
						found, foundEquipped, foundName = t.UUID, isEq, t.Name
					end
				end
			end
			if foundName then realName[base] = StripNumber(foundName) end

			-- 没装备的不放
			local usable = found and ((not hasFlag) or foundEquipped)
			if usable and not uuidByName[base] then
				print("[PinataStarter] " .. base .. " uuid = " .. tostring(found))
			end
			uuidByName[base] = usable and found or nil
		end
	end
end

task.spawn(function()
	while task.wait(1) do
		pcall(RefreshUUIDs)
	end
end)

