local function IsEndScreenVisible()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local gg = pg and pg:FindFirstChild("GameGui")
	local es = gg and gg:FindFirstChild("EndScreen")
	if not es then return false end

	local ok, v = pcall(function()
		if es:IsA("LayerCollector") then return es.Enabled end
		return es.Visible
	end)
	return ok and v == true
end

local function CallExitGame()
	local events = ReplicatedStorage:FindFirstChild("Events")
	local remote = events and events:FindFirstChild("ExitGame")
	if not remote then return false end

	pcall(function()
		if remote:IsA("RemoteFunction") then
			remote:InvokeServer()
		else
			remote:FireServer()
		end
	end)
	return true
end

task.spawn(function()
	local lastFire = 0
	while task.wait(0.2) do
		if IsInGame() and IsEndScreenVisible() then
			if tick() - lastFire > 1 then
				lastFire = tick()
				print("[PinataStarter] 结算界面出现, 调用 ExitGame")
				task.spawn(CallExitGame)
			end
		else
			lastFire = 0
		end
	end
end)

