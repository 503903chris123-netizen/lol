-- King 领域 (无编号 + 2~8)
task.spawn(function()
	local domain
	while task.wait(2) do
		if IsJujutsuHigh() and not JJH.stopAll then
			pcall(function()
				if not domain then
					local r = ReplicatedStorage:FindFirstChild("Remotes")
					r = r and r:FindFirstChild("Towers")
					r = r and r:FindFirstChild("KingOfCursesEvo")
					domain = r and r:FindFirstChild("DomainActive")
				end
				if not domain then return end

				local folder = Workspace:FindFirstChild("Towers")
				if not folder then return end
				local base = JJH_TOWERS.KING
				local t = folder:FindFirstChild(base)
				if t then pcall(function() domain:FireServer(t) end) end
				for i = 2, 8 do
					local ti = folder:FindFirstChild(base .. i)
					if ti then pcall(function() domain:FireServer(ti) end) end
				end
			end)
		end
	end
end)

-- Wave 50: 停止并卖掉所有塔
task.spawn(function()
	while task.wait(0.5) do
		if IsJujutsuHigh() then
			pcall(function()
				local info = Workspace:FindFirstChild("Info")
				local wave = info and info:FindFirstChild("Wave")
				if not wave then return end

				if wave.Value >= 50 and not JJH.stopAll then
					JJH.stopAll = true
					print("[JujutsuHigh] Wave >= 50, 停止并卖塔")
				end

				if JJH.stopAll then
					local folder = Workspace:FindFirstChild("Towers")
					if folder then
						for _, t in ipairs(folder:GetChildren()) do
							pcall(function() SellTower:InvokeServer(t) end)
							task.wait(0.01)
						end
					end
				end
			end)
		end
	end
end)

