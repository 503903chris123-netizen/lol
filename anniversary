--========================================================--
-- MAX PERFORMANCE (脚本一启动就开, 不管在哪张图)
--   只在客户端删视觉效果: 灯光 (Light) / 贴图 (Decal / Texture / SurfaceAppearance / MeshPart.TextureID / SpecialMesh) / 粒子 / 阴影 / 后处理 / 别人的角色外观
--   绝不删: Part / Model / Value / Remote / Prompt / Gui, 也不碰 Teleporters / PinataTeleporters / Towers / Mobs 的结构
--   所以放塔 / 升级 / Owner 判断 / Map 检测 / 传送器 / Pinata 追踪 都不受影响
--========================================================--

local PERF_ENABLED = true
local PERF_FPS_CAP = 0              -- 0 = 不限帧; 想限制就写 60 / 144
local PERF_DISABLE_3D = false       -- true = 直接关掉 3D 渲染 (最省, 但画面全黑, 只靠 UI 看状态)
local PERF_STRIP_PLAYERS = true     -- 别人的角色: 删配饰 / 衣服 / 脸
local PERF_SKIP = { Teleporters = true, PinataTeleporters = true }   -- 这些文件夹里面完全不动

if PERF_ENABLED then
	task.spawn(function()
		local okPerf, errPerf = pcall(function()
		local Lighting = game:GetService("Lighting")
		local RunService = game:GetService("RunService")

		-- 全局渲染设置
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
		pcall(function() settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04 end)
		pcall(function() settings().Physics.AllowSleep = true end)
		pcall(function() if setfpscap then setfpscap(PERF_FPS_CAP) end end)
		pcall(function() if PERF_DISABLE_3D then RunService:Set3dRenderingEnabled(false) end end)

		-- 光照
		local function ApplyLighting()
			pcall(function() Lighting.GlobalShadows = false end)
			pcall(function() Lighting.FogEnd = 9e9; Lighting.FogStart = 9e9 end)
			pcall(function() Lighting.ShadowSoftness = 0 end)
			pcall(function() Lighting.EnvironmentDiffuseScale = 0; Lighting.EnvironmentSpecularScale = 0 end)
			pcall(function() if sethiddenproperty then sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility) end end)
			-- 没有天空 / 灯光之后场景全靠环境光, 调成统一的亮灰色, 不会黑屏
			pcall(function()
				Lighting.Ambient = Color3.fromRGB(190, 190, 190)
				Lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190)
				Lighting.Brightness = 1
				Lighting.ClockTime = 12
			end)
			for _, c in ipairs(Lighting:GetChildren()) do
				if c:IsA("PostEffect") or c:IsA("Atmosphere") or c:IsA("Clouds") or c:IsA("Sky") then
					pcall(function() c:Destroy() end)
				end
			end
		end
		ApplyLighting()
		Lighting.ChildAdded:Connect(function(c)
			if c:IsA("PostEffect") or c:IsA("Atmosphere") or c:IsA("Clouds") or c:IsA("Sky") then
				task.defer(function() pcall(function() c:Destroy() end) end)
			end
		end)

		-- 地形 / 水
		pcall(function()
			local terrain = Workspace:FindFirstChildOfClass("Terrain")
			if terrain then
				terrain.WaterWaveSize, terrain.WaterWaveSpeed = 0, 0
				terrain.WaterReflectance, terrain.WaterTransparency = 0, 1
				if sethiddenproperty then sethiddenproperty(terrain, "Decoration", false) end
			end
		end)

		local function InSkipped(inst)
			local p = inst
			while p and p ~= Workspace do
				if PERF_SKIP[p.Name] and p.Parent == Workspace then return true end
				p = p.Parent
			end
			return false
		end

		local function IsOtherCharacter(inst)
			local model = inst:FindFirstAncestorOfClass("Model")
			while model do
				local plr = Players:GetPlayerFromCharacter(model)
				if plr then return plr ~= LocalPlayer end
				model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model")
			end
			return false
		end

		-- 处理单个对象 (只做视觉降级, 不删结构)
		local function Strip(inst)
			if InSkipped(inst) then return end

			if inst:IsA("BasePart") then
				inst.CastShadow = false
				inst.Reflectance = 0
				inst.Material = Enum.Material.SmoothPlastic
				if inst:IsA("MeshPart") then
					pcall(function() inst.RenderFidelity = Enum.RenderFidelity.Performance end)
					pcall(function() inst.TextureID = "" end)
				end
			elseif inst:IsA("Decal") or inst:IsA("Texture") or inst:IsA("SurfaceAppearance")
				or inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
				or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") or inst:IsA("Explosion")
				or inst:IsA("Highlight") or inst:IsA("SelectionBox") then
				pcall(function() inst:Destroy() end)
			elseif inst:IsA("Light") then
				-- 灯光: PointLight / SpotLight / SurfaceLight 直接删
				pcall(function() inst:Destroy() end)
			elseif inst:IsA("SpecialMesh") then
				pcall(function() inst.TextureId = "" end)
			elseif PERF_STRIP_PLAYERS and (inst:IsA("Accessory") or inst:IsA("Clothing")
				or inst:IsA("ShirtGraphic") or inst:IsA("BodyColors")) then
				if IsOtherCharacter(inst) then pcall(function() inst:Destroy() end) end
			end
		end

		-- 新出现的对象: 先攒起来, 下一帧再批量处理 (怪物 / 特效一次出很多个时不卡)
		local queue, qn = {}, 0
		Workspace.DescendantAdded:Connect(function(inst)
			qn = qn + 1
			queue[qn] = inst
		end)

		task.spawn(function()
			while true do
				RunService.Heartbeat:Wait()
				local n = math.min(qn, 400)
				for i = 1, n do
					local inst = queue[i]
					if inst and inst.Parent then pcall(Strip, inst) end
				end
				if n > 0 then
					table.move(queue, n + 1, qn, 1)
					for i = qn - n + 1, qn do queue[i] = nil end
					qn = qn - n
				end
			end
		end)

		-- 现有的全部处理一遍 (分批, 避免启动时卡一下)
		local count = 0
		for _, inst in ipairs(Workspace:GetDescendants()) do
			pcall(Strip, inst)
			count = count + 1
			if count % 300 == 0 then RunService.Heartbeat:Wait() end
		end

		-- 别人的角色: 之后有人进 / 重生也处理
		if PERF_STRIP_PLAYERS then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer and plr.Character then
					for _, d in ipairs(plr.Character:GetDescendants()) do pcall(Strip, d) end
				end
			end
		end

		print("[PinataStarter] Max Performance 已开启 · 处理了 " .. count .. " 个对象")
		end)
		if not okPerf then warn("[PinataStarter] Max Performance 出错 (不影响其余功能): " .. tostring(errPerf)) end
	end)
end

