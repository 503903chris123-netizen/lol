local function FlatDist(a, b)
	return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
end

-- 走到某一点 (不 TP): 先寻路, 失败就直走; 卡住会跳
local function WalkTo(goal, abort, timeout)
	timeout = timeout or 45
	local t0 = tick()

	local function moveTo(pos, per)
		local h, r = GetHumanoid(), GetRoot()
		if not (h and r) then return false end
		h:MoveTo(pos)

		local start = tick()
		local lastPos, lastCheck = r.Position, tick()
		while tick() - start < per do
			if abort and abort() then return false end
			r = GetRoot()
			if not r then return false end
			if FlatDist(r.Position, pos) <= 3 then return true end

			if tick() - lastCheck >= 1 then
				if (r.Position - lastPos).Magnitude < 1 then
					h.Jump = true
					h:MoveTo(pos)
				end
				lastPos, lastCheck = r.Position, tick()
			end
			task.wait(0.1)
		end
		return false
	end

	local r = GetRoot()
	if not r then return false end

	local ok, path = pcall(function()
		local p = PathfindingService:CreatePath({ AgentRadius = 2.5, AgentHeight = 5, AgentCanJump = true })
		p:ComputeAsync(r.Position, goal)
		return p
	end)

	if ok and path and path.Status == Enum.PathStatus.Success then
		for _, wp in ipairs(path:GetWaypoints()) do
			if tick() - t0 > timeout then break end
			if abort and abort() then return false end
			if wp.Action == Enum.PathWaypointAction.Jump then
				local h = GetHumanoid()
				if h then h.Jump = true end
			end
			moveTo(wp.Position, 3)
		end
	end

	return moveTo(goal, math.max(5, timeout - (tick() - t0)))
end

local function FindPrompt(elev)
