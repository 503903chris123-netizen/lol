	if prompt then
		local pos = PromptPosition(prompt)
		if pos then return pos end
	end
	local ok, pivot = pcall(function() return elev:GetPivot() end)
	return ok and pivot and pivot.Position or nil
end

-- 长按互动键 (默认 E, 有 ProximityPrompt 就用它的键和长按时长)
local function HoldInteract(elev)
	local prompt = FindPrompt(elev)
	local hold = 2  -- 每次长按 2 秒, 循环
	local key = (prompt and prompt.KeyboardKeyCode) or Enum.KeyCode.E
	if key == Enum.KeyCode.Unknown then key = Enum.KeyCode.E end

	local vim
	pcall(function() vim = game:GetService("VirtualInputManager") end)

	if vim then
		pcall(function() vim:SendKeyEvent(true, key, false, game) end)
		task.wait(hold)
		pcall(function() vim:SendKeyEvent(false, key, false, game) end)
	elseif prompt then
		pcall(function() prompt:InputHoldBegin() end)
		task.wait(hold)
		pcall(function() prompt:InputHoldEnd() end)
	end
end

-- 读传送器人数: 返回 当前, 上限, 文字 (找不到返回 nil)
local function ReadCount(elev)
	local label
	pcall(function() label = elev.Billboard.BillboardGui.Title.PlayerCount end)
	if not label then
		label = elev:FindFirstChild("PlayerCount", true)
	end
	if not label then return nil end

	local ok, text = pcall(function() return label.Text end)
	if not ok or type(text) ~= "string" then return nil end

	text = text:gsub("<[^>]+>", "")
	local cur, max = string.match(text, "(%d+)%s*/%s*(%d+)")
	if not cur then return nil, nil, text end
	return tonumber(cur), tonumber(max), text
end

local function IsFull(elev)
	local cur, max = ReadCount(elev)
	if not cur then return false end
	return cur >= (max or 10)
end

