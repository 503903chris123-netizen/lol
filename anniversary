-- Pinata 越过塔多少格才删掉重放 (有 initial 的组: 第一次用固定位置时, 越过就删, 不加 margin)
local function Margin(g)
	if g.initial and not g.leftInitial then return 0 end
	return g.margin or 0
end

-- 触发删除的 Pinata X: 越过 anchor 这么远
local function DeleteX(g)
	if not g.anchor then return nil end
	return g.anchor.X + Dir(g) * Margin(g)
end

-- 这一组场上自己的塔
local function GetGroupTowers(g)
	local list = {}
	for _, t in ipairs(MyTowers()) do
		for _, base in ipairs(g.towers) do
			if InstMatches(t.Name, base) then
				table.insert(list, t)
				break
			end
		end
	end
	return list
end

-- 场上自己的某个塔名的数量
local function CountMine(base)
	local n = 0
	for _, t in ipairs(MyTowers()) do
		if InstMatches(t.Name, base) then n = n + 1 end
	end
	return n
end

-- 场上自己的第一个这个塔名的实例
local function FindMine(base)
	for _, t in ipairs(MyTowers()) do
		if InstMatches(t.Name, base) then return t end
	end
	return nil
end

-- 放塔之前先拿到目标位置: 组里已经有位置就用它; 还没有 -> 用 Pinata 中心点 + offset 算 (Y / Z 固定)
local function ResolveTarget(g)
	if g.anchor then return g.anchor end

	local p = GetPinataPosition()
	if not p then return nil end

	g.anchor = Vector3.new(p.X + g.offset, FIXED_Y, FIXED_Z)
	print("[PinataStarter] " .. g.title .. " 放置位置: " .. tostring(g.anchor))
	AddLog("place", string.format("%s 目标位置 X=%.0f", g.title, g.anchor.X))
	return g.anchor
end

-- 每个塔名一个疯狂放置循环 (只在 Pinata 图里放; 自己列表里这个塔数量是 0 才放)
local function StartPlacer(g, base)
	-- 同一组里每个塔 X 错开一点 (不叠放); Kogane 不偏移
	local slotX = 0
	if base ~= "Kogane" then
		local idx = 0
		for _, b in ipairs(g.towers) do
			if b == base then break end
			if b ~= "Kogane" then idx = idx + 1 end
		end
		slotX = idx * TOWER_SPACING
	end

	task.spawn(function()
		local lastWarn = 0
		while true do
			task.wait(PLACE_DELAY)
			pcall(function()
				if g.selling or not IsPinataMap() then return end
				if CountMine(base) > 0 then return end
				if tick() - (pendingPlace[base] or 0) < PLACE_GUARD then return end

				-- 1) 先拿目标放置位置 (Pinata 中心点 + 偏移 X)
				local pos = ResolveTarget(g)
				if not pos then return end

				if base == "Kogane" then
					-- 2) Kogane: 必须先有自己的 Meguna (KingOfCursesEvo), 再绑定到它上面
					local king = FindMine(MEGUNA_NAME)
					if not king then
						g.kingInst = nil
						return
					end
					if g.kingInst ~= king then
						g.kingInst, g.kingAt = king, tick()
					end
					if tick() - (g.kingAt or 0) < KING_SETTLE then return end

					local uuid = uuidByName[base] or KOGANE_UUID
					local ok, ret = pcall(function()
						return SpawnNewTower:InvokeServer(uuid, CFrame.new(pos) * KOGANE_ANGLES, king)
					end)
					if ok then NotePlaced(base, ret) end
					if ok and ret then
						AddLog("place", string.format("放置 Kogane · X=%.0f", pos.X))
					elseif tick() - lastWarn > 1 then
						lastWarn = tick()
						warn("[Kogane] 放置失败", ok, ret)
					end
				else
					local uuid = uuidByName[base]
					if not uuid then return end

					local target = pos + Vector3.new(slotX, 0, 0)
					local ok, ret = pcall(function()
						return SpawnNewTower:InvokeServer(uuid, CFrame.new(target))
					end)
					if ok then NotePlaced(base, ret) end
					if ok and ret then
						AddLog("place", string.format("放置 %s · X=%.0f", realName[base] or base, target.X))
					end
				end
			end)
		end
	end)
end

for _, g in ipairs(GROUPS) do
	for _, base in ipairs(g.towers) do
		StartPlacer(g, base)
	end
end

