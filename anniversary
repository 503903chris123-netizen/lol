local function NameMatches(instName, base)
	local n = string.lower(tostring(instName))
	local b = string.lower(base)
	if string.sub(n, 1, #b) ~= b then return false end
	return string.match(string.sub(n, #b + 1), "^[%s%d_%-%.%(%)]*$") ~= nil
end

local function DataNameMatches(base, name)
	if base == AMPLIFYING then
		return string.find(string.lower(tostring(name)), "amplif", 1, true) ~= nil
	end
	return NameMatches(name, base)
end

local function StripNumber(name)
	local base = string.gsub(tostring(name), "[%s_%-%.]*%d+$", "")
	return base
end

-- 场上的塔实例是否属于这个塔名
local function InstMatches(instName, base)
	if base == AMPLIFYING then
		return string.find(string.lower(tostring(instName)), "amplif", 1, true) ~= nil
	end
	return NameMatches(instName, realName[base] or base)
end

local uuidByName = {}   -- [塔名] = uuid
local lastData = 0

local function RefreshUUIDs()
	if tick() - lastData < 3 then return end
	lastData = tick()

	local ok, data = pcall(function() return GetAllData:InvokeServer() end)
	if not ok or type(data) ~= "table" or type(data.Towers) ~= "table" then return end

	local hasFlag = false
	for _, t in pairs(data.Towers) do
		if type(t) == "table" and t.Equipped ~= nil then hasFlag = true break end
	end

	for _, g in ipairs(GROUPS) do
		for _, base in ipairs(g.towers) do
			local found, foundEquipped, foundName
			for _, t in pairs(data.Towers) do
				if type(t) == "table" and t.Name and t.UUID and DataNameMatches(base, t.Name) then
					local isEq = (not hasFlag) or (t.Equipped == true)
					if not found or (isEq and not foundEquipped) then
						found, foundEquipped, foundName = t.UUID, isEq, t.Name
					end
				end
			end
			if foundName then realName[base] = StripNumber(foundName) end

			-- 没装备的不放
			local usable = found and ((not hasFlag) or foundEquipped)
			if usable and not uuidByName[base] then
				print("[PinataStarter] " .. base .. " uuid = " .. tostring(found))
			end
			uuidByName[base] = usable and found or nil
		end
	end
end

task.spawn(function()
	while task.wait(1) do
		pcall(RefreshUUIDs)
	end
end)

