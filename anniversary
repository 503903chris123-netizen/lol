		if ok and g then return g end
		return LocalPlayer:WaitForChild("PlayerGui")
	end

	pcall(function()
		local old = GetGuiParent():FindFirstChild("PinataStarterUI")
		if old then old:Destroy() end
	end)

	local Gui = New("ScreenGui", {
		Name = "PinataStarterUI", ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999, IgnoreGuiInset = true,
	})
	Gui.Parent = GetGuiParent()

	local MAIN_W, FULL_H, HEADER_H = 360, 560, 64

	local Main = New("Frame", {
		Name = "Main", Size = UDim2.new(0, MAIN_W, 0, FULL_H),
		Position = UDim2.new(0, 24, 0.5, -FULL_H / 2),
		BackgroundColor3 = COLORS.bg, BorderSizePixel = 0, ClipsDescendants = true,
	}, Gui)
	Corner(Main, 18)
	Stroke(Main, COLORS.line, 1, 0.1)

	-- Header
	local Header = New("Frame", { Size = UDim2.new(1, 0, 0, HEADER_H), BackgroundTransparency = 1 }, Main)

	local Mark = New("Frame", {
		Size = UDim2.new(0, 32, 0, 32), Position = UDim2.new(0, 18, 0.5, -16),
		BackgroundColor3 = COLORS.accent, BackgroundTransparency = 0.86, BorderSizePixel = 0,
	}, Header)
	Corner(Mark, 10)
	Stroke(Mark, COLORS.accent, 1, 0.6)
	local MarkText = Label(Mark, "P", 15, COLORS.accent, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
	MarkText.Size = UDim2.new(1, 0, 1, 0)

	local Title = Label(Header, "Pinata Starter", 16, COLORS.text, Enum.Font.GothamBold)
	Title.Size = UDim2.new(0, 200, 0, 20)
	Title.Position = UDim2.new(0, 62, 0, 13)

	local SubTitle = Label(Header, "lobby · track pinata · place · upgrade", 11, COLORS.sub, Enum.Font.Gotham)
	SubTitle.Size = UDim2.new(0, 240, 0, 14)
	SubTitle.Position = UDim2.new(0, 62, 0, 34)

	local StateBadge = Label(Header, "WAIT", 11, COLORS.gray, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
	StateBadge.AnchorPoint = Vector2.new(1, 0.5)
	StateBadge.Position = UDim2.new(1, -18, 0.5, 0)
	StateBadge.Size = UDim2.new(0, 84, 0, 24)
	StateBadge.BackgroundColor3 = COLORS.gray
	StateBadge.BackgroundTransparency = 0.88
	Corner(StateBadge, 12)

	New("Frame", {
		Size = UDim2.new(1, -36, 0, 1), Position = UDim2.new(0, 18, 0, HEADER_H),
		BackgroundColor3 = COLORS.line, BackgroundTransparency = 0.35, BorderSizePixel = 0,
	}, Main)

	-- Body
	local Body = New("Frame", {
		Size = UDim2.new(1, -32, 1, -(HEADER_H + 24)), Position = UDim2.new(0, 16, 0, HEADER_H + 14),
		BackgroundTransparency = 1,
	}, Main)
	New("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, Body)

	local function BuildOffsetCard(g, order)
		local card = New("Frame", {
			Size = UDim2.new(1, 0, 0, 96), BackgroundColor3 = COLORS.surface, BorderSizePixel = 0, LayoutOrder = order,
		}, Body)
		Corner(card, 14)
		Stroke(card, COLORS.line, 1, 0.25)

		local t = Label(card, g.title, 12, COLORS.text, Enum.Font.GothamBold)
		t.Position = UDim2.new(0, 14, 0, 12)
		t.Size = UDim2.new(0, 80, 0, 18)
		local st = Label(card, g.sub, 11, COLORS.dim, Enum.Font.Gotham)
		st.Position = UDim2.new(0, 14, 0, 31)
		st.Size = UDim2.new(1, -130, 0, 16)
		st.TextTruncate = Enum.TextTruncate.AtEnd

		local box = New("TextBox", {
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 10),
			Size = UDim2.new(0, 96, 0, 28), BackgroundColor3 = COLORS.tile, BorderSizePixel = 0,
			Text = tostring(g.offset), PlaceholderText = "0", TextColor3 = COLORS.text,
			PlaceholderColor3 = COLORS.dim, TextSize = 14, Font = Enum.Font.GothamBold,
			ClearTextOnFocus = false,
		}, card)
		Corner(box, 8)
		local boxStroke = Stroke(box, COLORS.line, 1, 0.2)

		local function SetOffset(n)
			if n ~= g.offset then
				g.offset = n
				g.reanchor = true
			end
			box.Text = tostring(g.offset)
		end

		local function StepButton(text, x, delta)
			local b = New("TextButton", {
				Position = UDim2.new(0, x, 0, 56), Size = UDim2.new(0, 46, 0, 24),
				BackgroundColor3 = COLORS.tile, BorderSizePixel = 0, Text = text,
				TextColor3 = COLORS.sub, TextSize = 11, Font = Enum.Font.GothamBold, AutoButtonColor = false,
			}, card)
			Corner(b, 7)
			b.MouseEnter:Connect(function() Tween(b, { TextColor3 = COLORS.text }, 0.12) end)
			b.MouseLeave:Connect(function() Tween(b, { TextColor3 = COLORS.sub }, 0.12) end)
			b.MouseButton1Click:Connect(function() SetOffset(g.offset + delta) end)
		end
		StepButton("-10", 14, -10)
		StepButton("-1", 66, -1)
		StepButton("+1", 118, 1)
		StepButton("+10", 170, 10)

		box.Focused:Connect(function() Tween(boxStroke, { Color = COLORS.accent }, 0.15) end)
		box.FocusLost:Connect(function()
			local n = tonumber(box.Text)
			SetOffset(n or g.offset)
			Tween(boxStroke, { Color = COLORS.line }, 0.15)
		end)
	end

	for i, g in ipairs(GROUPS) do
		BuildOffsetCard(g, i)
	end

	-- 状态卡片
	local StatCard = New("Frame", {
		Size = UDim2.new(1, 0, 0, 216), BackgroundColor3 = COLORS.surface, BorderSizePixel = 0, LayoutOrder = 10,
	}, Body)
	Corner(StatCard, 14)
	Stroke(StatCard, COLORS.line, 1, 0.25)

	local function Row(y, caption)
		local c = Label(StatCard, caption, 11, COLORS.sub, Enum.Font.GothamMedium)
		c.Position = UDim2.new(0, 14, 0, y)
		c.Size = UDim2.new(0, 110, 0, 18)
		local v = Label(StatCard, "-", 13, COLORS.text, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
		v.AnchorPoint = Vector2.new(1, 0)
		v.Position = UDim2.new(1, -14, 0, y)
		v.Size = UDim2.new(1, -130, 0, 18)
		v.TextTruncate = Enum.TextTruncate.AtEnd
		return v
	end

	local VPinata = Row(12, "PINATA X")
	local VStarterGap = Row(36, "Starter 距删除")
	local VMegunaGap = Row(60, "Meguna 距删除")
	local VStarterCount = Row(84, "场上 Starter")
	local VMegunaCount = Row(108, "场上 Meguna 组")
	local VUuid = Row(132, "可放的塔")
	local VNext = Row(156, "下次 Pinata")
	local VLobby = Row(180, "大厅状态")

	local function GapText(g, px)
		if px and g.anchor then
			-- 还差多少格 Pinata 就越过塔足够远, 到 0 就会删掉重放
			local remaining = Margin(g) + (g.anchor.X - px) * Dir(g)
			return string.format("%.1f", remaining), remaining <= 3 and COLORS.amber or COLORS.text
		end
		return "-", COLORS.text
	end

	local function Refresh()
		local px = lastPinataX
		VPinata.Text = px and string.format("%.1f", px) or "-"

		VStarterGap.Text, VStarterGap.TextColor3 = GapText(GROUPS[1], px)
		VMegunaGap.Text, VMegunaGap.TextColor3 = GapText(GROUPS[2], px)

		VStarterCount.Text = tostring(#GetGroupTowers(GROUPS[1]))
		VMegunaCount.Text = tostring(#GetGroupTowers(GROUPS[2]))

		local usable, total = 0, 0
		for _, g in ipairs(GROUPS) do
			for _, base in ipairs(g.towers) do
				total = total + 1
				if uuidByName[base] then usable = usable + 1 end
			end
		end
		VUuid.Text = usable .. " / " .. total

		-- 下次 Pinata
		local want, ev = WantPinata()
		local _, _, secs = EventInfo()
		if want then
			VNext.Text = secs > 0 and string.format("%d:%02d 后开始", math.floor(secs / 60), secs % 60) or "窗口内"
			VNext.TextColor3 = COLORS.amber
		else
			local untilPrep = (ev + 3600 - PREP_SECONDS) - os.time()
			if GetDone() ~= ev and (os.time() - ev) > AFTER_SECONDS then
				-- 当前小时的窗口已过, 下一次在下个整点
				VNext.Text = string.format("%d 分后准备", math.max(0, math.floor(((ev + 3600 - PREP_SECONDS) - os.time()) / 60)))
			else
				VNext.Text = string.format("%d 分后准备", math.max(0, math.floor(untilPrep / 60)))
			end
			VNext.TextColor3 = COLORS.text
		end

		VLobby.Text = LobbyState.status .. (LobbyState.countText ~= "-" and (" · " .. LobbyState.countText) or "")

		local badge, color
		if IsPinataMap() then
			if not px then
				badge, color = "NO PINATA", COLORS.gray
			elseif GROUPS[1].selling or GROUPS[2].selling then
				badge, color = "RESET", COLORS.amber
			else
				badge, color = "ACTIVE", COLORS.green
			end
		elseif IsInGame() then
			badge, color = IsJujutsuHigh() and "JUJUTSU" or "OTHER MAP", IsJujutsuHigh() and COLORS.green or COLORS.gray
		else
			badge = want and "→ PINATA" or "LOBBY"
			color = want and COLORS.amber or COLORS.accent
		end
		StateBadge.Text = badge
		Tween(StateBadge, { TextColor3 = color, BackgroundColor3 = color })
	end

	task.spawn(function()
		while task.wait(0.1) do
			pcall(Refresh)
		end
	end)

	-- 拖动
	do
		local dragging, dragStart, startPos
		Header.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = Main.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then dragging = false end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local d = input.Position - dragStart
				Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end)
	end

	-- 右侧可拖动小按钮, 点击开关 UI
	local ToggleBtn = New("TextButton", {
		Name = "ToggleBtn", Size = UDim2.new(0, 46, 0, 46), Position = UDim2.new(1, -72, 0.5, -23),
		BackgroundColor3 = COLORS.bg, Text = "PS", TextColor3 = COLORS.text, TextSize = 13,
		Font = Enum.Font.GothamBold, AutoButtonColor = false, ZIndex = 50,
	}, Gui)
	Corner(ToggleBtn, 23)
	local ToggleStroke = Stroke(ToggleBtn, COLORS.accent, 1.5, 0.35)
	ToggleBtn.MouseEnter:Connect(function() Tween(ToggleStroke, { Transparency = 0 }, 0.15) end)
	ToggleBtn.MouseLeave:Connect(function() Tween(ToggleStroke, { Transparency = 0.35 }, 0.15) end)

	local function SetUiVisible(v)
		Main.Visible = v
		Tween(ToggleBtn, { BackgroundColor3 = v and COLORS.bg or COLORS.surface }, 0.2)
	end

	do
		local pressing, moved = false, false
		local pressPos, btnStart

		ToggleBtn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				pressing = true
				moved = false
				pressPos = input.Position
				btnStart = ToggleBtn.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						pressing = false
						if not moved then SetUiVisible(not Main.Visible) end
					end
				end)
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if pressing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local d = input.Position - pressPos
				if d.Magnitude > 6 then moved = true end
				if moved then
					ToggleBtn.Position = UDim2.new(btnStart.X.Scale, btnStart.X.Offset + d.X, btnStart.Y.Scale, btnStart.Y.Offset + d.Y)
				end
			end
		end)
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.RightControl then
			SetUiVisible(not Main.Visible)
		end
	end)
end)

