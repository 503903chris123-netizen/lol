local LobbyState = { status = "等待中", target = nil, heldAt = 0, mode = nil, countText = "-" }

local function GetRoot()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
	local char = LocalPlayer.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function FlatDist(a, b)
	return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
end

-- 走到某一点 (不 TP): 先寻路, 失败就直走; 卡住会跳
local function WalkTo(goal, abort, timeout)
	timeout = timeout or 45
	local t0 = tick()

	local function moveTo(pos, per)
		local h, r = GetHumanoid(), GetRoot()
		if not (h and r) then return false end
		h:MoveTo(pos)

		local start = tick()
		local lastPos, lastCheck = r.Position, tick()
		while tick() - start < per do
			if abort and abort() then return false end
			r = GetRoot()
			if not r then return false end
			if FlatDist(r.Position, pos) <= 3 then return true end

			if tick() - lastCheck >= 1 then
				if (r.Position - lastPos).Magnitude < 1 then
					h.Jump = true
					h:MoveTo(pos)
				end
				lastPos, lastCheck = r.Position, tick()
			end
			task.wait(0.1)
		end
		return false
	end

	local r = GetRoot()
	if not r then return false end

	local ok, path = pcall(function()
		local p = PathfindingService:CreatePath({ AgentRadius = 2.5, AgentHeight = 5, AgentCanJump = true })
		p:ComputeAsync(r.Position, goal)
		return p
	end)

	if ok and path and path.Status == Enum.PathStatus.Success then
		for _, wp in ipairs(path:GetWaypoints()) do
			if tick() - t0 > timeout then break end
			if abort and abort() then return false end
			if wp.Action == Enum.PathWaypointAction.Jump then
				local h = GetHumanoid()
				if h then h.Jump = true end
			end
			moveTo(wp.Position, 3)
		end
	end

	return moveTo(goal, math.max(5, timeout - (tick() - t0)))
end

local function FindPrompt(elev)
	return elev:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function PromptPosition(prompt)
	local p = prompt.Parent
	if p and p:IsA("BasePart") then return p.Position end
	if p and p:IsA("Attachment") then return p.WorldPosition end
	return nil
end

-- 走过去的目标点: 有互动提示就走到提示旁边, 否则走到传送器中心
local function StandPosition(elev)
	local prompt = FindPrompt(elev)
	if prompt then
		local pos = PromptPosition(prompt)
		if pos then return pos end
	end
	local ok, pivot = pcall(function() return elev:GetPivot() end)
	return ok and pivot and pivot.Position or nil
end

-- 激活 ProximityPrompt: 不模拟按键 / 鼠标 (点击会进不去)
-- 优先 fireproximityprompt (先把长按时间设成 0); 没有这个函数就用 InputHoldBegin / InputHoldEnd
local function ActivatePrompt(prompt)
	if not prompt then return false end

	pcall(function() prompt.HoldDuration = 0 end)

	if typeof(fireproximityprompt) == "function" then
		local ok = pcall(function() fireproximityprompt(prompt) end)
		if ok then return true end
	end

	local ok = pcall(function()
		prompt:InputHoldBegin()
		task.wait(0.15)
		prompt:InputHoldEnd()
	end)
	return ok
end

-- 读传送器人数: 返回 当前, 上限, 文字 (找不到返回 nil)
local function ReadCount(elev)
	local label
	pcall(function() label = elev.Billboard.BillboardGui.Title.PlayerCount end)
	if not label then
		label = elev:FindFirstChild("PlayerCount", true)
	end
	if not label then return nil end

	local ok, text = pcall(function() return label.Text end)
	if not ok or type(text) ~= "string" then return nil end

	text = text:gsub("<[^>]+>", "")
	local cur, max = string.match(text, "(%d+)%s*/%s*(%d+)")
	if not cur then return nil, nil, text end
	return tonumber(cur), tonumber(max), text
end

local function IsFull(elev)
	local cur, max = ReadCount(elev)
	if not cur then return false end
	return cur >= (max or 10)
end

local function GetPinataTeleporters()
	local folder = Workspace:FindFirstChild("PinataTeleporters")
	local list = {}
	if not folder then return list end
	for _, e in ipairs(folder:GetChildren()) do
		if ReadCount(e) ~= nil or FindPrompt(e) then
			table.insert(list, e)
		end
	end
	return list
end

