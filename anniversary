--========================================================--
-- 放置 / 删除 / 重放
--========================================================--

local function Dir(g)
	return g.offset >= 0 and 1 or -1
end

-- Pinata 越过塔多少格才删掉重放 (有 initial 的组: 第一次用固定位置时, 越过就删, 不加 margin)
local function Margin(g)
	if g.initial and not g.leftInitial then return 0 end
	return g.margin or 0
end

local function GetGroupTowers(g)
	local list = {}
	local towers = Workspace:FindFirstChild("Towers")
	if not towers then return list end

	for _, t in ipairs(towers:GetChildren()) do
		for _, base in ipairs(g.towers) do
			if InstMatches(t.Name, base) then
				table.insert(list, t)
				break
			end
		end
	end
	return list
end

-- 场上某个塔名的数量
local function CountTower(base)
	local n = 0
	local towers = Workspace:FindFirstChild("Towers")
	if not towers then return 0 end
	for _, t in ipairs(towers:GetChildren()) do
		if InstMatches(t.Name, base) then n = n + 1 end
	end
	return n
end

-- 离放塔点够近才放 (不够近时, 下面的走路循环会先走过去)
local function IsNearPos(pos)
	local char = LocalPlayer.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")
	if not r then return false end
	local a, b = r.Position, pos
	return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude <= PLACE_RANGE
end

-- 每个塔名一个疯狂放置循环 (只在 Pinata 图里放)
local function StartPlacer(g, base)
	-- 同一组里每个塔 X 错开一点 (不叠放); Kogane 不偏移
	local slotX = 0
	if base ~= "Kogane" then
		local idx = 0
		for _, b in ipairs(g.towers) do
			if b == base then break end
			if b ~= "Kogane" then idx = idx + 1 end
		end
		slotX = idx * TOWER_SPACING
	end

	task.spawn(function()
		local lastWarn = 0
		while true do
			local pos = g.anchor
			if pos and not g.selling and IsPinataMap() and IsNearPos(pos) then
				if base == "Kogane" then
					-- Kogane: 场上数量是 0 就一直循环放, 放上去 (数量 > 0) 才退出这个内层循环
					-- GetAllData 拿不到 uuid 就用固定 uuid; 要先有 KingOfCursesEvo, 绑定它
					while CountTower("Kogane") == 0
						and g.anchor == pos and not g.selling
						and IsPinataMap() and IsNearPos(pos) do

						local uuid = uuidByName[base] or KOGANE_UUID
						local towers = Workspace:FindFirstChild("Towers")
						local king = towers and towers:FindFirstChild(MEGUNA_NAME)
						if king then
							local ok, ret = pcall(function()
								return SpawnNewTower:InvokeServer(uuid, CFrame.new(pos) * KOGANE_ANGLES, king)
							end)
							if not (ok and ret) and tick() - lastWarn > 1 then
								lastWarn = tick()
								warn("[Kogane] 放置失败", ok, ret)
							end
						end
						task.wait(PLACE_DELAY)
					end
				else
					local uuid = uuidByName[base]
					if uuid then
						pcall(function() SpawnNewTower:InvokeServer(uuid, CFrame.new(pos + Vector3.new(slotX, 0, 0))) end)
					end
				end
			end
			task.wait(PLACE_DELAY)
		end
	end)
end

for _, g in ipairs(GROUPS) do
	for _, base in ipairs(g.towers) do
		StartPlacer(g, base)
	end
end

local sellingInst = {}  -- [塔实例] = true (删除请求还没返回)

-- 跟踪 Pinata: 第一次定位, 之后 Pinata 走到某组塔后面 (或改了偏移) 就删掉这组塔重放
task.spawn(function()
	while task.wait(0.03) do
		pcall(function()
			if not IsPinataMap() then
				lastPinataX = nil
				return
			end

			local pos = GetPinataPosition()
			if not pos then return end
			lastPinataX = pos.X

			for _, g in ipairs(GROUPS) do
				if not g.anchor then
					g.anchor = Vector3.new(pos.X + g.offset, FIXED_Y, FIXED_Z)
					print("[PinataStarter] " .. g.title .. " 放置位置: " .. tostring(g.anchor))
				else
					local passed = g.reanchor or (pos.X - g.anchor.X) * Dir(g) >= Margin(g)
					if passed or g.selling then
						-- 条件成立: 疯狂删除这组塔, 直到删干净, 再按最新位置重放 (条件随之不再成立)
						g.selling = true
						local left = GetGroupTowers(g)
						if #left == 0 then
							g.reanchor = false
							g.leftInitial = true
							g.anchor = Vector3.new(pos.X + g.offset, FIXED_Y, FIXED_Z)
							g.selling = false
							print("[PinataStarter] " .. g.title .. " 已删除, 重放位置: " .. tostring(g.anchor))
						else
							for _, t in ipairs(left) do
								if not sellingInst[t] then
									sellingInst[t] = true
									task.delay(0.25, function() sellingInst[t] = nil end)  -- 请求卡住也要重发
									task.spawn(function()
										pcall(function() SellTower:InvokeServer(t) end)
										sellingInst[t] = nil
									end)
								end
							end
						end
					end
				end
			end
		end)
	end
end)

