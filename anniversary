local function SetMode(mode)
	if LobbyState.mode ~= mode then
		LobbyState.mode = mode
		LobbyState.target = nil
		LobbyState.heldAt = 0
	end
end

-- Pinata: 走到人数 < 10 的传送器, 用 ProximityPrompt 触发 (不模拟按键); 满人了就换另一个
local PRESS_GRACE = 20     -- 第一次触发之后这么多秒内, 当作"已经进去了", 不会因为满人而换走
local SKIP_SECONDS = 20    -- 被换掉的传送器这么久内不再选
local WALK_TIMEOUT = 15    -- 走路最多这么久, 还没到就直接 TP 到传送器旁边

local function PinataLobby()
	if LobbyState.mode ~= "pinata" then
		LobbyState.skip, LobbyState.pressedAt, LobbyState.firstPress = {}, {}, {}
	end
	SetMode("pinata")

	local list = GetPinataTeleporters()
	if #list == 0 then
		LobbyState.status = "等待 PinataTeleporters"
		return
	end

	local root = GetRoot()
	if not root then LobbyState.status = "等待角色" return end

	local function recentlyPressed(e)
		local t = LobbyState.firstPress[e]
		return t ~= nil and tick() - t < PRESS_GRACE
	end

	local target = LobbyState.target
	if target and not target.Parent then target = nil end

	-- 目标满人了, 而且不是刚触发过的 (自己可能就在里面) -> 换一个, 不管离得近不近
	if target and IsFull(target) and not recentlyPressed(target) then
		LobbyState.skip[target] = tick() + SKIP_SECONDS
		LobbyState.firstPress[target] = nil
		LobbyState.pressedAt[target] = nil
		target = nil
	end

	if not target then
		for _, e in ipairs(list) do
			if (not IsFull(e)) and tick() >= (LobbyState.skip[e] or 0) then
				target = e
				break
			end
		end
		if not target then
			-- 没有可选的: 把已经不满的从跳过表里放出来, 下一轮重选
			for e in pairs(LobbyState.skip) do
				if not IsFull(e) then LobbyState.skip[e] = nil end
			end
			LobbyState.target = nil
			LobbyState.status = "传送器都满了, 等待"
			return
		end
		LobbyState.target = target
		LobbyState.firstPress[target] = nil
		LobbyState.pressedAt[target] = nil
	end

	local _, _, text = ReadCount(target)
	LobbyState.countText = text or "-"

	local pos = StandPosition(target)
	if not pos then LobbyState.status = "找不到传送器位置" return end

	-- 离得远: 先走过去; 走了 WALK_TIMEOUT 秒还没到 (卡住了) 就直接 TP 到传送器旁边
	if FlatDist(root.Position, pos) > NEAR_DIST then
		LobbyState.status = "走向 " .. target.Name
		local chosen = target
		WalkTo(pos, function()
			return IsInGame() or (not WantPinata()) or LobbyState.target ~= chosen
		end, WALK_TIMEOUT)

		root = GetRoot()
		if root and LobbyState.target == chosen and (not IsInGame()) and WantPinata()
			and FlatDist(root.Position, pos) > NEAR_DIST then
			LobbyState.status = "走不到, TP 到 " .. chosen.Name
			pcall(function() root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) end)
		end
		return
	end

	-- 在传送器旁边: 触发互动提示; 触发过之后每 HOLD_RETRY 秒还没进游戏就再触发一次
	local prompt = FindPrompt(target)
	local last = LobbyState.pressedAt[target] or 0
	if last == 0 or tick() - last >= HOLD_RETRY then
		if prompt and prompt.Enabled == false then
			LobbyState.status = "互动不可用 · " .. target.Name
			return
		end
		LobbyState.status = "互动 · " .. target.Name
		LobbyState.pressedAt[target] = tick()
		if not LobbyState.firstPress[target] then
			LobbyState.firstPress[target] = tick()
		end
		if not ActivatePrompt(prompt) then
			LobbyState.status = "找不到互动提示 · " .. target.Name
		end
	else
		LobbyState.status = "已触发, 等待开始 · " .. target.Name
	end
end

-- Teleporter1: 绕圈 tween 让传送器检测到玩家进入 (不绕圈进不去)
--   hardTP = true: 先瞬间 TP 到传送器上方再绕圈 (第一次不 TP, 直接绕; 5 秒没进才 TP 重来)
local CIRCLE_RADIUS = 4.5
local CIRCLE_STEPS = 12
local CIRCLE_STEP_TIME = 0.08
local ENTER_WAIT = 5       -- 绕圈后这么多秒还没进传送器 -> 重新 TP 绕圈

-- Teleporter1 坐标: 第一次看到传送器时记下来 (内存 + 文件), 之后即使传送器还没加载出来也直接用这个坐标
local TP1_FILE = "Teleporter1Pos.txt"

local function GetTP1Pos()
	if environment.Tp1Pos then return environment.Tp1Pos end
	pcall(function()
		if isfile and isfile(TP1_FILE) then
			local x, y, z = string.match(readfile(TP1_FILE), "^%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)")
			if x then environment.Tp1Pos = Vector3.new(tonumber(x), tonumber(y), tonumber(z)) end
		end
	end)
	return environment.Tp1Pos
end

local function SaveTP1Pos(v)
	local old = environment.Tp1Pos
	if old and (old - v).Magnitude < 1 then return end
	environment.Tp1Pos = v
	print("[PinataStarter] 记录 Teleporter1 坐标: " .. tostring(v))
	pcall(function()
		if writefile then writefile(TP1_FILE, string.format("%.3f,%.3f,%.3f", v.X, v.Y, v.Z)) end
	end)
end

-- pos: 传送器的坐标 (Vector3), 不需要传送器实例已经加载
local function TeleportInto(pos, hardTP)
	local root = GetRoot()
	if not root then return false end

	local center = pos + Vector3.new(0, 3, 0)
	if hardTP then
		pcall(function() root.CFrame = CFrame.new(center) end)
	end

	for i = 1, CIRCLE_STEPS do
		if IsInGame() then return true end
		root = GetRoot()
		if not root then return false end

		local ang = (i / CIRCLE_STEPS) * math.pi * 2
		local p = center + Vector3.new(math.cos(ang) * CIRCLE_RADIUS, 0, math.sin(ang) * CIRCLE_RADIUS)
		local ok = pcall(function()
			local tw = TweenService:Create(root, TweenInfo.new(CIRCLE_STEP_TIME, Enum.EasingStyle.Linear), {
				CFrame = CFrame.new(p),
			})
			tw:Play()
			tw.Completed:Wait()
		end)
		if not ok then return false end
	end

	root = GetRoot()
	if root then
		pcall(function() root.CFrame = CFrame.new(center) end)
	end
	return true
end

-- 普通关: 进第一个传送器, 选关并开始 (和主脚本同样的 remote)
--   没进去 (绕圈后 ENTER_WAIT 秒内人数 / 位置都不对) -> 下一轮 TP + 绕圈重来
local function NormalLobby()
	if LobbyState.mode ~= "normal" then
		LobbyState.enterTry = 0
	end
	SetMode("normal")

	local root = GetRoot()
	if not root then LobbyState.status = "等待角色" return end

	-- 1) 传送器加载出来了: 记下它的坐标; 没加载出来: 用之前记下的坐标
	local folder = Workspace:FindFirstChild("Teleporters")
	local elev = folder and folder:FindFirstChild("Teleporter1")

	local pos
	if elev then
		local ok, pivot = pcall(function() return elev:GetPivot() end)
		if ok and pivot then
			pos = pivot.Position
			SaveTP1Pos(pos)
		end
	end
	pos = pos or GetTP1Pos()

	if not pos then
		LobbyState.status = "等待传送器加载 (还没有记录坐标)"
		return
	end

	-- 2) 传送器没加载出来 (区域没流式加载): 直接 TP 到记录的坐标, 等它加载出来
	if not elev then
		LobbyState.target = nil
		LobbyState.status = "传送器未加载 · 前往记录的坐标"
		pcall(function() root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) end)

		local t0 = tick()
		while tick() - t0 < 6 do
			if IsInGame() then return end
			folder = Workspace:FindFirstChild("Teleporters")
			elev = folder and folder:FindFirstChild("Teleporter1")
			if elev then break end
			task.wait(0.2)
		end
		if not elev then return end   -- 下一轮继续
	end
	LobbyState.target = elev

	local _, _, text = ReadCount(elev)
	LobbyState.countText = text or "-"

	-- 刚离开过 (里面有别人): 冷却一会再回来
	if tick() < (LobbyState.leaveUntil or 0) then
		LobbyState.status = "有人, 等待后重试"
		return
	end

	-- 算"进去了": 人在传送器范围内, 并且人数 >= 1 (读不到人数就只看位置)
	local function Inside()
		local r = GetRoot()
		if not r then return false end
		if FlatDist(r.Position, pos) > 8 then return false end
		local cur = ReadCount(elev)
		return cur == nil or cur >= 1
	end

	if not Inside() then
		local try = LobbyState.enterTry or 0
		if try == 0 then
			LobbyState.status = "绕圈 · " .. elev.Name
		else
			LobbyState.status = "重新 TP 绕圈 (第 " .. (try + 1) .. " 次) · " .. elev.Name
		end

		TeleportInto(pos, try > 0)

		-- 绕完圈后最多等 ENTER_WAIT 秒确认进去了
		local t0 = tick()
		while tick() - t0 < ENTER_WAIT do
			if IsInGame() then return end
			if Inside() then break end
			task.wait(0.2)
		end

		if not Inside() then
			LobbyState.enterTry = try + 1
			return   -- 下一轮: TP 过去重新绕圈
		end
	end
	LobbyState.enterTry = 0

	-- 进去之后如果有别人 (人数 > 1, 含自己) -> leave
	local cur = ReadCount(elev)
	if cur and cur > 1 then
		LobbyState.status = "有别人, 离开 " .. elev.Name
		local rs = ReplicatedStorage:FindFirstChild("Remotes")
		local tps = rs and rs:FindFirstChild("Teleporters")
		if tps then
			for _, name in ipairs({ "Leave", "LeaveTeleporter", "LeaveStage", "Exit", "Cancel" }) do
				local r = tps:FindFirstChild(name)
				if r then
					pcall(function() r:FireServer(elev) end)
				end
			end
		end
		-- 再走出传送器范围
		root = GetRoot()
		if root then
			pcall(function() root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 18)) end)
		end
		LobbyState.leaveUntil = tick() + 5
		return
	end

	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local tp = remotes and remotes:FindFirstChild("Teleporters")
	local choose = tp and tp:FindFirstChild("ChooseStage")
	local start = tp and tp:FindFirstChild("Start")
	if not (choose and start) then
		LobbyState.status = "找不到 Remotes.Teleporters"
		return
	end

	LobbyState.status = "进入 " .. elev.Name .. " · 开始游戏"
	pcall(function() choose:FireServer(elev, 1, "Normal", true) end)
	pcall(function() start:FireServer(elev) end)
end

