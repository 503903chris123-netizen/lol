-- 从 GetAllData 按名字取 uuid (不看有没有带); 农场塔里确定是哪一个 (Equipped5 对应的)
local jjhUUID, jjhFarmKey, jjhLoaded, jjhLast = {}, nil, false, 0

local function JJHRefresh()
	if tick() - jjhLast < 3 then return end
	jjhLast = tick()

	local ok, data = pcall(function() return GetAllData:InvokeServer() end)
	if not ok or type(data) ~= "table" or type(data.Towers) ~= "table" then return end

	local farmUUID = JJHFarmUUID()
	local newUUID, newEq, farmKey = {}, {}, nil

	for _, t in pairs(data.Towers) do
		if type(t) == "table" and t.Name and t.UUID then
			for key, base in pairs(JJH_TOWERS) do
				if NameMatches(t.Name, base) then
					local eq = t.Equipped == true
					if not newUUID[key] or (eq and not newEq[key]) then
						newUUID[key] = t.UUID
						newEq[key] = eq
					end
					if JJH_FARM[key] then
						if t.UUID == farmUUID then
							farmKey = key
						elseif eq and not farmKey then
							farmKey = key
						end
					end
				end
			end
		end
	end

	jjhUUID, jjhFarmKey, jjhLoaded = newUUID, farmKey, true
end

