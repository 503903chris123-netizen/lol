		Tween(Dot, { BackgroundColor3 = color })
	end

	local function RefreshClock()
		local now = os.time()
		local ev, inWin = EventInfo()
		local done = GetDone() == ev
		local target, phase, color, frac = ev, "", C.sub, 0

		if inWin and not done then
			if now < ev then
				phase, color = "准备中", C.amber
			else
				phase, color = "进行中 · 剩 " .. Fmt(ev + AFTER_SECONDS - now), C.green
			end
			frac = math.clamp((now - (ev - PREP_SECONDS)) / (PREP_SECONDS + AFTER_SECONDS), 0, 1)
		else
			target = ev + 3600
			phase = (inWin and done) and "本次已打过" or "等待下次"
			color = (inWin and done) and C.green or C.sub
		end

		ClockTime.Text = os.date("%H:%M", target)
		ClockPhase.Text = phase
		ClockPhase.TextColor3 = color
		ClockCount.Text = (target > now) and ("还有 " .. Fmt(target - now)) or "已到点"
		Tween(BarFill, { Size = UDim2.new(frac, 0, 1, 0), BackgroundColor3 = color }, 0.3)
	end

	local function RefreshLobby()
		-- Teleporter1
		local folder = Workspace:FindFirstChild("Teleporters")
		local t1 = folder and folder:FindFirstChild("Teleporter1")
		if t1 then
			local cur, max, text = ReadCount(t1)
			T1Big.Text = text or "-"
			local chosen = LobbyState.mode == "normal" and LobbyState.target == t1
			local color, desc
			if chosen then
				color, desc = C.accent, "已选择 · " .. (LobbyState.status or "")
			elseif cur and cur == 0 then
				color, desc = C.green, "空 · 可进入"
			elseif cur then
				color, desc = C.gray, "有人"
			else
				color, desc = C.gray, "-"
			end
			T1Sub.Text = desc
			T1Sub.TextColor3 = color
			T1Big.TextColor3 = (cur and cur == 0) and C.green or C.text
			Tween(T1Stroke, { Color = chosen and C.accent or C.line, Transparency = chosen and 0.2 or 0.3 })
		else
			T1Big.Text, T1Sub.Text = "-", "等待传送器加载"
			T1Sub.TextColor3 = C.gray
		end

		-- Pinata 传送器
		local list = GetPinataTeleporters()
		local sumCur, sumMax, free = 0, 0, 0
		for _, e in ipairs(list) do
			local cur, max = ReadCount(e)
			if cur then
				sumCur = sumCur + cur
				sumMax = sumMax + (max or 10)
				if cur < (max or 10) then free = free + 1 end
			end
		end

		local ptTarget = LobbyState.mode == "pinata" and LobbyState.target or nil
		if ptTarget and ptTarget.Parent then
			local _, _, text = ReadCount(ptTarget)
			PTBig.Text = text or "-"
			PTSub.Text = ptTarget.Name .. " · 已选 · " .. free .. " 个可进"
			PTSub.TextColor3 = C.accent
			Tween(PTStroke, { Color = C.accent, Transparency = 0.2 })
		else
			PTBig.Text = #list > 0 and (sumCur .. "/" .. sumMax) or "-"
			PTSub.Text = #list > 0 and (free .. " / " .. #list .. " 个可进") or "等待 PinataTeleporters"
			PTSub.TextColor3 = free > 0 and C.green or C.gray
			Tween(PTStroke, { Color = C.line, Transparency = 0.3 })
		end
		PTBig.TextColor3 = C.text

		-- 小格子
		local names = {}
		for _, e in ipairs(list) do table.insert(names, e.Name) end
		local sig = table.concat(names, ",")
		if sig ~= chipSig then
			chipSig = sig
			for _, c in pairs(chips) do c.frame:Destroy() end
			chips = {}
			for i, e in ipairs(list) do
				local f = New("Frame", { BackgroundColor3 = C.btn, BorderSizePixel = 0, LayoutOrder = i }, ChipGrid)
				Corner(f, 7)
				local fs = Stroke(f, C.line, 1, 0.6)
				local l = Label(f, "", 10, C.text, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
				l.Size = UDim2.new(1, 0, 1, 0)
				chips[e] = { frame = f, stroke = fs, label = l, idx = i }
			end
		end
		ChipTitle.Text = "Pinata 传送器 · " .. #list .. " 个"
		for e, c in pairs(chips) do
			if e.Parent then
				local cur, max = ReadCount(e)
				c.label.Text = c.idx .. " · " .. (cur and (cur .. "/" .. (max or 10)) or "-")
				local color = C.green
				if ptTarget == e then color = C.accent
				elseif cur and cur >= (max or 10) then color = C.gray end
				c.label.TextColor3 = color
				Tween(c.stroke, { Color = color }, 0.15)
			end
		end

		VMode.Text = WantPinata() and "Pinata 传送器" or "Teleporter1 (Stage 1)"
		VMode.TextColor3 = WantPinata() and C.amber or C.text
		VStay.Text = lobbySince and (Fmt(tick() - lobbySince) .. " / " .. Fmt(REJOIN_SECONDS)) or "-"
	end

	local function RefreshJJH()
		local wave = "-"
		pcall(function()
			local info = Workspace:FindFirstChild("Info")
			local w = info and info:FindFirstChild("Wave")
			if w then wave = tostring(w.Value) end
		end)
		JWave.Text = wave

		local timer = "-"
		pcall(function()
			local info = Workspace:FindFirstChild("Info")
			local t = info and info:FindFirstChild("Time")
			local tm = t and t:FindFirstChild("Timer")
			if tm then
				local v = tm.Value
				timer = type(v) == "number" and Fmt(v) or tostring(v)
			end
		end)
		JTime.Text = timer

		pcall(function()
			local g = LocalPlayer:FindFirstChild("Gold")
			JGold.Text = g and Commas(g.Value) or "-"
		end)

		local pn = #Players:GetPlayers()
		JPlayers.Text = tostring(pn)
		JPlayers.TextColor3 = pn > 1 and C.amber or C.text

		if JJH.stopAll then
			JPhase.Text, JPhase.TextColor3 = "STOPPED (Wave 50)", C.red
		elseif not jjhLoaded then
			JPhase.Text, JPhase.TextColor3 = "读取塔数据…", C.gray
		elseif not JJH.phaseDone then
			JPhase.Text, JPhase.TextColor3 = "Miracle ×2 → Lv4", C.amber
		else
			JPhase.Text = JJH.upgradeBlocked and "全放 + 升级 (蜗牛暂停部分)" or "全放 + 升级"
			JPhase.TextColor3 = JJH.upgradeBlocked and C.amber or C.green
		end

		JFarm.Text = jjhFarmKey and JJH_NAMES[jjhFarmKey] or "-"

		local eqTotal, placedTotal = 0, 0
		for key, u in pairs(tiles) do
			local base = JJH_TOWERS[key]
			local list = JJHTowers(key)
			local levels = {}
			for _, t in ipairs(list) do table.insert(levels, JJHLevel(t)) end
			table.sort(levels)

			local eq
			if JJH_FARM[key] then eq = (jjhFarmKey == key) else eq = jjhEq[key] == true end
			if eq then eqTotal = eqTotal + 1 end
			placedTotal = placedTotal + #list

			local target = JJH_TARGET[key] or 1
			local color, state
			if #list >= target then
				color = C.green
			elseif #list > 0 then
				color = C.amber
			elseif eq then
				color = C.accent
			else
				color = C.gray
			end

			local lv = ""
			if #levels > 0 then
				local parts = {}
				for _, l in ipairs(levels) do table.insert(parts, "Lv" .. l) end
				lv = table.concat(parts, "｜")
			end
			state = (eq and "已带" or (JJH_FARM[key] and "非当前农场" or "未带")) .. (lv ~= "" and (" · " .. lv) or " · 未放置")

			u.state.Text = state
			u.state.TextColor3 = (#list > 0) and C.accent or (eq and C.sub or C.dim)
			u.name.TextColor3 = (eq or #list > 0) and C.text or C.dim
			u.count.Text = #list .. "/" .. target
			u.count.TextColor3 = color
			Tween(u.dot, { BackgroundColor3 = color })
			Tween(u.stroke, { Color = color, Transparency = (#list > 0) and 0.35 or 0.7 })
		end
		JTilesTitle.Text = string.format("塔 · 带了 %d · 已放 %d (自己的)", eqTotal, placedTotal)
	end

	-- Y: X 越大越靠上 (Pinata 从上往下走)
	local function MapY(x)
		return (mapTop - x) / (mapTop - mapBottom) * COR_H
	end

	local function RefreshPinata()
		local px = lastPinataX

		-- 地图范围
		if not px then
			mapTop, mapBottom = nil, nil
			PinataMark.Visible = false
			for _, l in ipairs(lines) do
				l.place.Visible, l.placeLbl.Visible, l.del.Visible, l.delLbl.Visible = false, false, false, false
			end
		else
			if not mapTop then
				mapTop = px + 14
				mapBottom = mapTop - MAP_SPAN
			end
			local function Include(x)
				if x + 10 > mapTop then mapTop = x + 10 end
				if x - 10 < mapBottom then mapBottom = x - 10 end
			end
			Include(px)
			for _, g in ipairs(GROUPS) do
				if g.anchor then
					Include(g.anchor.X)
					Include(DeleteX(g))
				end
			end

			PinataMark.Visible = true
			PinataMark.Position = UDim2.new(0.5, 0, 0, math.clamp(MapY(px), 11, COR_H - 11))

			for i, g in ipairs(GROUPS) do
				local l = lines[i]
				if g.anchor then
					local py, dy = MapY(g.anchor.X), MapY(DeleteX(g))
					l.place.Visible, l.placeLbl.Visible = true, true
					l.place.Position = UDim2.new(0, 0, 0, py - 1)
					l.placeLbl.Position = UDim2.new(0, 3, 0, math.clamp(py - 12, 0, COR_H - 11))
					l.del.Visible, l.delLbl.Visible = true, true
					l.del.Position = UDim2.new(0, 0, 0, dy - 1)
					l.delLbl.Position = UDim2.new(1, -33, 0, math.clamp(dy - 12, 0, COR_H - 11))
					l.del.BackgroundColor3 = g.selling and C.amber or C.red
					l.del.Size = UDim2.new(1, 0, 0, g.selling and 3 or 2)
				else
					l.place.Visible, l.placeLbl.Visible, l.del.Visible, l.delLbl.Visible = false, false, false, false
				end
			end

			AxisTop.Text = string.format("X %.0f", mapTop)
			AxisBottom.Text = string.format("X %.0f", mapBottom)
		end

		-- 自己的塔 (来自列表) 画在走廊里
		local alive = {}
		if px and mapTop then
			for gi, g in ipairs(GROUPS) do
				for _, t in ipairs(GetGroupTowers(g)) do
					alive[t] = true
					local base
					for _, b in ipairs(g.towers) do
						if InstMatches(t.Name, b) then base = b break end
					end
					local ok, cf = pcall(function() return t:GetPivot() end)
					if ok and cf and base then
						local d = dots[t]
						if not d then
							local f = New("Frame", {
								Size = UDim2.new(0, 18, 0, 18), AnchorPoint = Vector2.new(0.5, 0.5),
								BackgroundColor3 = (base == "Kogane") and C.amber or (gi == 1 and C.accent or C.rose),
								BorderSizePixel = 0, ZIndex = 4,
							}, Corridor)
							Corner(f, 9)
							Stroke(f, C.bg, 1.5, 0)
							local l = Label(f, TAG[base] or "??", 8, C.bg, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
							l.Size = UDim2.new(1, 0, 1, 0)
							l.ZIndex = 5
							d = { frame = f }
							dots[t] = d
						end
						d.frame.Position = UDim2.new(LANE[base] or 0.5, 0, 0, math.clamp(MapY(cf.Position.X), 9, COR_H - 9))
					end
				end
			end
		end
		for inst, d in pairs(dots) do
			if not alive[inst] then
				d.frame:Destroy()
				dots[inst] = nil
			end
		end

		-- 右侧信息
		SPinata.Text = px and string.format("%.1f", px) or "-"

		local function DelText(g)
			if px and g.anchor then
				local remain = Margin(g) + (g.anchor.X - px) * Dir(g)
				return remain <= 0 and "即将删除" or string.format("还差 %.0f 格", remain), remain
			end
			return "-", nil
		end

		local t1, r1 = DelText(GROUPS[1])
		local t2, r2 = DelText(GROUPS[2])
		SStarterDel.Text, SStarterDel.TextColor3 = t1, (r1 and r1 <= 5) and C.amber or C.text
		SMegunaDel.Text, SMegunaDel.TextColor3 = t2, (r2 and r2 <= 5) and C.amber or C.text

		local function StateText(g)
			if g.selling then return "删除中", C.red end
			local expected, have = 0, #GetGroupTowers(g)
			for _, base in ipairs(g.towers) do
				if uuidByName[base] or base == "Kogane" then expected = expected + 1 end
			end
			if have >= expected and expected > 0 then
				return string.format("就位 %d/%d", have, expected), C.green
			end
			return string.format("放置中 %d/%d", have, expected), C.amber
		end
		SStarterState.Text, SStarterState.TextColor3 = StateText(GROUPS[1])
		SMegunaState.Text, SMegunaState.TextColor3 = StateText(GROUPS[2])
		SOffset.Text = GROUPS[1].offset .. " / " .. GROUPS[2].offset

		-- 日志
		local now = os.time()
		for i, row in ipairs(logRows) do
			local e = Log[i]
			if e then
				local ago = now - e.t
				row.Text = string.format("%s  %s", ago < 60 and (ago .. "s") or (math.floor(ago / 60) .. "m"), e.text)
				row.TextColor3 = (e.kind == "sell") and C.red or C.green
			else
				row.Text = ""
			end
		end
	end

	local function Refresh()
		local want = WantPinata()
		local inGame = IsInGame()
		local pinata = IsPinataMap()
		local jjh = inGame and (not pinata) and IsJujutsuHigh()

		LobbyPage.Visible = not inGame
		PinataPage.Visible = pinata
		JJHPage.Visible = jjh
		OtherPage.Visible = inGame and (not pinata) and (not jjh)

		pcall(RefreshClock)

		local badge, color, status
		if pinata then
			if not lastPinataX then
				badge, color = "NO PINATA", C.gray
			elseif GROUPS[1].selling or GROUPS[2].selling then
				badge, color = "RESET", C.amber
			else
				badge, color = "ACTIVE", C.green
			end
			status = string.format("Pinata · 我的塔 %d 座", #MyTowers())
			pcall(RefreshPinata)
		elseif jjh then
			badge, color = "JUJUTSU", C.green
			status = string.format("JujutsuHigh · 我的塔 %d 座", #MyTowers())
			pcall(RefreshJJH)
		elseif inGame then
			badge, color, status = "OTHER MAP", C.gray, LobbyState.status
		else
			badge = want and "→ PINATA" or "LOBBY"
			color = want and C.amber or C.accent
			status = LobbyState.status
			pcall(RefreshLobby)
		end

		SetBadge(badge, color)
		Status.Text = status or ""
	end

	task.spawn(function()
		while task.wait(0.15) do
			pcall(Refresh)
		end
	end)

	--------------------------------------------------------
	-- 拖动 / 开关
	--------------------------------------------------------
	do
		local dragging, dragStart, startPos
		Header.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = Main.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then dragging = false end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local d = input.Position - dragStart
				Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end)
	end

	local ToggleBtn = New("TextButton", {
		Name = "ToggleBtn", Size = UDim2.new(0, 40, 0, 40), Position = UDim2.new(1, -64, 0.5, -20),
		BackgroundColor3 = C.bg, Text = "P", TextColor3 = C.accent, TextSize = 15,
		Font = Enum.Font.GothamBold, AutoButtonColor = false, ZIndex = 50,
	}, Gui)
	Corner(ToggleBtn, 20)
	local ToggleStroke = Stroke(ToggleBtn, C.accent, 1.5, 0.45)
	ToggleBtn.MouseEnter:Connect(function() Tween(ToggleStroke, { Transparency = 0 }, 0.15) end)
	ToggleBtn.MouseLeave:Connect(function() Tween(ToggleStroke, { Transparency = 0.45 }, 0.15) end)

	local function SetUiVisible(v)
		Main.Visible = v
		Tween(ToggleBtn, { BackgroundColor3 = v and C.bg or C.card }, 0.2)
	end

	do
		local pressing, moved = false, false
		local pressPos, btnStart

		ToggleBtn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				pressing = true
				moved = false
				pressPos = input.Position
				btnStart = ToggleBtn.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						pressing = false
						if not moved then SetUiVisible(not Main.Visible) end
					end
				end)
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if pressing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local d = input.Position - pressPos
				if d.Magnitude > 6 then moved = true end
				if moved then
					ToggleBtn.Position = UDim2.new(btnStart.X.Scale, btnStart.X.Offset + d.X, btnStart.Y.Scale, btnStart.Y.Offset + d.Y)
				end
			end
		end)
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.RightControl then
			SetUiVisible(not Main.Visible)
		end
	end)
end)

