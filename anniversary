local DONE_FILE = "PinataDoneEvent.txt"

-- 返回: 当前活动的整点 (os.time 秒), 是否在窗口内, 距离整点秒数 (负数 = 还没到)
local function EventInfo()
	local t = os.time()
	local ev = math.floor((t + PREP_SECONDS) / 3600) * 3600
	local inWindow = (t - ev) <= AFTER_SECONDS
	return ev, inWindow, ev - t
end

-- 这个整点的 Pinata 是否已经打过 (换服务器后靠文件记住)
local function GetDone()
	if environment.PinataDoneEvent == nil then
		pcall(function()
			if isfile and isfile(DONE_FILE) then
				environment.PinataDoneEvent = tonumber(readfile(DONE_FILE)) or 0
			end
		end)
	end
	return environment.PinataDoneEvent
end

local function MarkDone(ev)
	environment.PinataDoneEvent = ev
	pcall(function()
		if writefile then writefile(DONE_FILE, tostring(ev)) end
	end)
end

local function WantPinata()
	local ev, inWindow = EventInfo()
	return inWindow and GetDone() ~= ev, ev
end

