-- Pinata 图: Workspace.Map.Anniversary (地图名包含 anniversary 也算); 备用: 场上有 Pinata
local function IsPinataMap()
	if not IsInGame() then return false end

	local map = Workspace:FindFirstChild("Map")
	if map and map:FindFirstChild("Anniversary") then return true end
	if map then
		if string.find(string.lower(map.Name), PINATA_MAP_KEYWORD, 1, true) and map.Name ~= "Map" then
			return true
		end
		for _, c in ipairs(map:GetChildren()) do
			if string.find(string.lower(c.Name), PINATA_MAP_KEYWORD, 1, true) then
				return true
			end
		end
	end

	local mobs = Workspace:FindFirstChild("Mobs")
	if mobs and mobs:FindFirstChild("Pinata") then return true end
	return false
end

