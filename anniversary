-- JUJUTSU HIGH (Workspace.Map.JujutsuHigh, Stage 1 普通关) · 只认自己列表里的塔
--  用主脚本的放塔 / 升级逻辑: 2x Miracle 升到 Lv4 -> 之后疯狂放所有能放的塔 + 升级所有塔
--  不识别塔阵容: 不管有没有带, 全部尝试放 (放不了的自动退避); 农场塔只放 Equipped5 对应的那一个
--  同时带主脚本的 AutoSkip / King 领域 / 蜗牛暂停升级 / Wave 50 卖塔
--========================================================--

local JJH = { phaseDone = false, stopAll = false, upgradeBlocked = false, autoSkip = false }

local JJH_TOWERS = {
	BASIC = "MiracleSorcerer", HARVESTER = "HarvesterCurse", MEGUNA = "KingOfCursesEvo",
	AMPLIFYING = "AmplifyingSorcerer", KOGANE = "Kogane",
}
local JJH_NAMES = {
	BASIC = "Miracle", HARVESTER = "Harvester", MEGUNA = "Meguna",
	AMPLIFYING = "Amplifying", KOGANE = "Kogane",
}
local JJH_FARM = {}   -- 新塔里没有 Equipped5 农场塔的概念
local JJH_TARGET = { BASIC = 2, HARVESTER = 1, MEGUNA = 1, AMPLIFYING = 1, KOGANE = 1 }
-- 放置顺序: Miracle 先 (阶段 1), 之后全部; Kogane 要等 Meguna 先放下
local JJH_ORDER = { "BASIC", "HARVESTER", "MEGUNA", "AMPLIFYING", "KOGANE" }

-- 位置: 所有塔放同一坐标
local JJH_POS_CF = CFrame.new(-44.38, 16.86, -83.57)
local JJH_POS = {}
for key in pairs(JJH_TOWERS) do JJH_POS[key] = JJH_POS_CF end

local function IsJujutsuHigh()
	local map = Workspace:FindFirstChild("Map")
	return map ~= nil and map:FindFirstChild("JujutsuHigh") ~= nil
end

-- 塔名匹配: Amplifying 名字里带 "amplif"; Meguna 认 KingOfCursesEvo 或 meguna 开头
local function JJHMatch(key, instName)
	local n = string.lower(tostring(instName))
	if key == "AMPLIFYING" then
		return string.find(n, "amplif", 1, true) ~= nil
	end
	if key == "MEGUNA" then
		return NameMatches(instName, JJH_TOWERS.MEGUNA) or string.sub(n, 1, 6) == "meguna"
	end
	return NameMatches(instName, JJH_TOWERS[key])
end

-- 自己列表里的、这个 key 的塔
local function JJHTowers(key)
	local result = {}
	for _, t in ipairs(MyTowers()) do
		if JJHMatch(key, t.Name) then table.insert(result, t) end
	end
	return result
end

local function JJHLevel(tower)
	local attr = tower:GetAttribute("Level")
	if typeof(attr) == "number" then return attr end
	local lv = tower:FindFirstChild("Level") or tower:FindFirstChild("level")
	if lv and tonumber(lv.Value) then return tonumber(lv.Value) end
	return tonumber(string.match(tower.Name, "%d+")) or 1
end

-- 从 GetAllData 按名字取 uuid (不看有没有带)
local jjhUUID, jjhEq, jjhFarmKey, jjhLoaded, jjhLast = {}, {}, nil, false, 0

local function JJHRefresh()
	if tick() - jjhLast < 3 then return end
	jjhLast = tick()

	local ok, data = pcall(function() return GetAllData:InvokeServer() end)
	if not ok or type(data) ~= "table" or type(data.Towers) ~= "table" then return end

	local newUUID, newEq = {}, {}

	for _, t in pairs(data.Towers) do
		if type(t) == "table" and t.Name and t.UUID then
			for key in pairs(JJH_TOWERS) do
				if JJHMatch(key, t.Name) then
					local eq = t.Equipped == true
					if not newUUID[key] or (eq and not newEq[key]) then
						newUUID[key] = t.UUID
						newEq[key] = eq
					end
				end
			end
		end
	end

	jjhUUID, jjhEq, jjhLoaded = newUUID, newEq, true
end

task.spawn(function()
	while task.wait(1) do
		if IsJujutsuHigh() then pcall(JJHRefresh) end
	end
end)

local jjhLastTry, jjhFails = {}, {}

local function JJHPlace(key)
	if JJH.stopAll or not jjhLoaded then return false end

	local towerName = JJH_TOWERS[key]

	-- Kogane 要等自己的 Meguna 先放下
	if key == "KOGANE" and #JJHTowers("MEGUNA") == 0 then return false end

	-- 自己列表里已经够数了就不放
	if #JJHTowers(key) >= (JJH_TARGET[key] or 1) then return false end

	-- 刚发过放置请求, 等它出现在列表里
	if tick() - (pendingPlace[towerName] or 0) < PLACE_GUARD then return false end

	-- 放不了的 (没带 / 钱不够) 连续失败多次后退避
	local interval = ((jjhFails[key] or 0) >= 5) and 5 or 0.5
	if tick() - (jjhLastTry[key] or 0) < interval then return false end
	jjhLastTry[key] = tick()

	local uuid = jjhUUID[key]
	if key == "KOGANE" and not uuid then uuid = KOGANE_UUID end
	local pos = JJH_POS[key]
	if not uuid or not pos then return false end

	local ok, ret
	if key == "KOGANE" then
		-- Kogane 绑定自己的 Meguna
		local meguna = JJHTowers("MEGUNA")[1]
		if not meguna then return false end
		ok, ret = pcall(function() return SpawnNewTower:InvokeServer(uuid, pos, meguna) end)
	else
		ok, ret = pcall(function() return SpawnNewTower:InvokeServer(uuid, pos) end)
	end

	if ok and ret then
		NotePlaced(towerName, ret)
		jjhFails[key] = 0
		return true
	end
	jjhFails[key] = (jjhFails[key] or 0) + 1
	return false
end

-- 放塔主循环
task.spawn(function()
	while task.wait(0.1) do
		pcall(function()
			if not IsJujutsuHigh() or JJH.stopAll or not jjhLoaded then return end

			if not JJH.phaseDone then
				-- 没有 Miracle 可放就直接跳过阶段 1
				if not jjhUUID.BASIC then
					JJH.phaseDone = true
					return
				end
				if #JJHTowers("BASIC") < 2 then
					JJHPlace("BASIC")
				end
				return
			end

			for _, key in ipairs(JJH_ORDER) do
				if JJH.stopAll then break end
				JJHPlace(key)
				task.wait(0.03)
			end
		end)
	end
end)

-- 升级循环
task.spawn(function()
	while task.wait(0.3) do
		pcall(function()
			if not IsJujutsuHigh() or JJH.stopAll then return end

			local miracles = JJHTowers("BASIC")

			-- 阶段 1: 2 个 Miracle 升到 Lv4
			if not JJH.phaseDone then
				if #miracles < 2 then return end
				table.sort(miracles, function(a, b) return JJHLevel(a) < JJHLevel(b) end)
				for _, tower in ipairs(miracles) do
					if JJHLevel(tower) < 4 then
						pcall(function() UpgradeTower:InvokeServer(tower) end)
						return
					end
				end
				JJH.phaseDone = true
				print("[JujutsuHigh] Miracle 阶段完成")
				return
			end

			-- 之后: 升级自己所有的塔 (Miracle 到 4 级为止)
			for _, tower in ipairs(MyTowers()) do
				local isBasic = JJHMatch("BASIC", tower.Name)
				if (not isBasic) or JJHLevel(tower) < 4 then
					local affected = JJHMatch("MEGUNA", tower.Name)
						or JJHMatch("HARVESTER", tower.Name)
						or JJHMatch("KOGANE", tower.Name)
					if not (JJH.upgradeBlocked and affected) then
						pcall(function() UpgradeTower:InvokeServer(tower) end)
					end
				end
			end
		end)
	end
end)

