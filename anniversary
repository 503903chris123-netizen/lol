-- Pinata: 走到人数 < 10 的传送器, 长按互动键; 满人了 (还没到的时候) 就换
local function PinataLobby()
	SetMode("pinata")

	local list = GetPinataTeleporters()
	if #list == 0 then
		LobbyState.status = "等待 PinataTeleporters"
		return
	end

	local root = GetRoot()
	if not root then LobbyState.status = "等待角色" return end

	local target = LobbyState.target
	if target and not target.Parent then target = nil end

	-- 目标满人了, 并且自己还没站在里面 -> 换一个
	if target then
		local pos = StandPosition(target)
		local near = pos and FlatDist(root.Position, pos) <= NEAR_DIST
		if (not near) and IsFull(target) then
			target = nil
		end
	end

	if not target then
		for _, e in ipairs(list) do
			if not IsFull(e) then
				target = e
				break
			end
		end
		if not target then
			LobbyState.target = nil
			LobbyState.status = "传送器都满了, 等待"
			return
		end
		LobbyState.target = target
		LobbyState.heldAt = 0
	end

	local _, _, text = ReadCount(target)
	LobbyState.countText = text or "-"

	local pos = StandPosition(target)
	if not pos then LobbyState.status = "找不到传送器位置" return end

	local function abort()
		local want = WantPinata()
		return IsInGame() or (not want) or LobbyState.target ~= target
			or ((not IsFull(target)) == false and FlatDist((GetRoot() or root).Position, pos) > NEAR_DIST)
	end

	if FlatDist(root.Position, pos) > NEAR_DIST then
		LobbyState.status = "走向 " .. target.Name
		WalkTo(pos, abort)
		return
	end

	-- 在传送器旁边就一直长按 (每次 2 秒, 循环)
	LobbyState.status = "长按互动 · " .. target.Name
	LobbyState.heldAt = tick()
	HoldInteract(target)
end

-- Teleporter1: 瞬间 TP 到传送器上方, 再绕圈 tween 让传送器检测到玩家进入 (不绕圈进不去)
local CIRCLE_RADIUS = 4.5
local CIRCLE_STEPS = 12
local CIRCLE_STEP_TIME = 0.08

local function TeleportInto(elev)
	local root = GetRoot()
	if not root then return false end

	local okPivot, pivot = pcall(function() return elev:GetPivot() end)
	if not okPivot or not pivot then return false end

	-- 不先 TP 过去, 直接从当前位置开始绕圈 (第一步 tween 就会把人带到传送器旁)
	local center = pivot.Position + Vector3.new(0, 3, 0)

	for i = 1, CIRCLE_STEPS do
		if IsInGame() then return true end
		root = GetRoot()
		if not root then return false end

		local ang = (i / CIRCLE_STEPS) * math.pi * 2
		local p = center + Vector3.new(math.cos(ang) * CIRCLE_RADIUS, 0, math.sin(ang) * CIRCLE_RADIUS)
		local ok = pcall(function()
			local tw = TweenService:Create(root, TweenInfo.new(CIRCLE_STEP_TIME, Enum.EasingStyle.Linear), {
				CFrame = CFrame.new(p),
			})
			tw:Play()
			tw.Completed:Wait()
		end)
		if not ok then return false end
	end

	root = GetRoot()
	if root then
		pcall(function() root.CFrame = CFrame.new(center) end)
	end
	return true
end

