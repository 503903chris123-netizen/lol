--========================================================--
-- 疯狂对 Meguna 开领域 (无编号 + 1~8 全试)
--   塔到 DOMAIN_MAX_LEVEL 级后停开; 检测不到等级时照常开
--========================================================--

-- 读塔的等级: 先看属性, 再看名为 Level/Upgrade/Tier 的数值子对象 (顶层 + 一层子对象)
local function TowerLevel(tower)
	if not tower then return nil end

	for _, attr in ipairs({ "Level", "Upgrade", "Upgrades", "Tier", "Evolution" }) do
		local ok, v = pcall(function() return tower:GetAttribute(attr) end)
		if ok and type(v) == "number" then return v end
	end

	local function ValueOf(inst)
		if inst and inst:IsA("ValueBase") and type(inst.Value) == "number" then
			local n = string.lower(inst.Name)
			if n == "level" or n == "upgrade" or n == "upgrades" or n == "tier" then
				return inst.Value
			end
		end
		return nil
	end

	for _, child in ipairs(tower:GetChildren()) do
		local v = ValueOf(child)
		if v then return v end
	end
	for _, child in ipairs(tower:GetChildren()) do
		for _, sub in ipairs(child:GetChildren()) do
			local v = ValueOf(sub)
			if v then return v end
		end
	end

	return nil
end

local function CanDomain(tower)
	local lv = TowerLevel(tower)
	-- 检测不到等级时照常开
	return lv == nil or lv < DOMAIN_MAX_LEVEL
end

task.spawn(function()
	local remote
	while task.wait(DOMAIN_DELAY) do
		pcall(function()
			if not IsPinataMap() then return end

			if not remote then
				local r = ReplicatedStorage:FindFirstChild("Remotes")
				r = r and r:FindFirstChild("Towers")
				r = r and r:FindFirstChild(MEGUNA_NAME)
				remote = r and r:FindFirstChild("DomainActive")
			end
			if not remote then return end

			local towers = Workspace:FindFirstChild("Towers")
			if not towers then return end

			local t = towers:FindFirstChild(MEGUNA_NAME)
			if t and CanDomain(t) then
				pcall(function() remote:FireServer(t) end)
			end
			for i = 1, 8 do
				local ti = towers:FindFirstChild(MEGUNA_NAME .. i)
				if ti and CanDomain(ti) then
					pcall(function() remote:FireServer(ti) end)
				end
			end
		end)
	end
end)

