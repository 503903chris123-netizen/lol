-- Lazy: 每次使用时才去找, 找不到就报错 (调用处都包在 pcall 里, 所以只是这一次不执行).
local function Lazy(root, ...)
	local path = { ... }
	return setmetatable({}, {
		__index = function(_, key)
			local o = root
			for _, n in ipairs(path) do
				o = o and o:FindFirstChild(n)
			end
			if not o then
				error("missing: " .. table.concat(path, "."), 0)
			end
			local v = o[key]
			if type(v) == "function" then
				return function(_, ...) return v(o, ...) end
			end
			return v
		end,
	})
end

