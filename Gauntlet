local function UpdateLobbyView()
	local inGame = IsInGame()
	LobbyList.Visible = not inGame
	for _, def in ipairs(CATEGORY_DEFS) do
		cards[def.id].card.Visible = inGame
	end
	if inGame then return end

	LobbyStatus.Text = LobbyState.status or ""

	local elevators = GetElevators()
	local names = {}
	for _, e in ipairs(elevators) do table.insert(names, e.Name) end
	local sig = table.concat(names, ",")
	if sig ~= lobbySig then
		lobbySig = sig
		RebuildLobbyCards(elevators)
	end

	for _, c in ipairs(lobbyCards) do
		local text = GetCountText(c.elev)
		local empty = IsEmptyText(text)
		local isTarget = (LobbyState.target == c.elev)

		c.count.Text = text or "-"

		local color, label
		if isTarget then
			color, label = COLORS.accent, "已选择 · 进入中"
		elseif empty then
			color, label = COLORS.green, "空 · 可进入"
		else
			color, label = COLORS.gray, "有人"
		end

		c.state.Text = label
		c.state.TextColor3 = color
		c.count.TextColor3 = empty and COLORS.green or COLORS.text
		Tween(c.dot, { BackgroundColor3 = color })
		Tween(c.stroke, { Color = isTarget and COLORS.accent or COLORS.line,
			Transparency = isTarget and 0.4 or 0.25 })
	end
end

local function SetCard(id, color, badgeText, message)
	local c = cards[id]
	c.badge.Text = badgeText
	Tween(c.badge, { TextColor3 = color, BackgroundColor3 = color })
	Tween(c.stroke, { Color = (color == COLORS.red or color == COLORS.amber) and color or COLORS.line,
		Transparency = (color == COLORS.red or color == COLORS.amber) and 0.55 or 0.25 })
	c.msg.Text = message
	c.msg.TextColor3 = (color == COLORS.red or color == COLORS.amber) and color or COLORS.sub
end

local function SetUnit(id, key, color, text)
	local u = cards[id].units[key]
	u.state.Text = text
	Tween(u.state, { TextColor3 = color })
	Tween(u.dot, { BackgroundColor3 = color })
	Tween(u.stroke, { Color = (color == COLORS.red) and color or COLORS.line,
		Transparency = (color == COLORS.red) and 0.45 or 0.5 })
end

-- 放置数量 + 等级 --------------------------------------------
local function GetPlacedInfo(towerName)
	local list = GetTowersByName(towerName)
	local levels = {}
	for _, t in ipairs(list) do
		table.insert(levels, GetTowerLevel(t))
	end
	table.sort(levels)
	return #list, levels
end

local function UpdatePlacement()
	for _, def in ipairs(CATEGORY_DEFS) do
		for _, key in ipairs(def.units) do
			local u = cards[def.id].units[key]
			local towerName = TOWER_NAMES[key]
			local equipped = (not dataLoaded) or equippedSet[towerName]

			if not equipped then
				u.count.Text = ""
				u.levels.Text = ""
				u.name.TextColor3 = COLORS.dim
			else
				u.name.TextColor3 = COLORS.text
				local n, levels = GetPlacedInfo(towerName)
				u.count.Text = tostring(n)
				u.count.TextColor3 = (n > 0) and COLORS.text or COLORS.dim

				if n == 0 then
					u.levels.Text = "未放置"
					u.levels.TextColor3 = COLORS.dim
				else
					local parts = {}
					for _, lv in ipairs(levels) do
						table.insert(parts, "Lv" .. lv)
					end
					u.levels.Text = table.concat(parts, "｜")
					u.levels.TextColor3 = COLORS.accent
				end
			end
		end
	end
end

-- Evaluation -------------------------------------------------
local function Has(key)
	return equippedSet[TOWER_NAMES[key]] == true
end

local function Count(keys)
	local n = 0
	for _, k in ipairs(keys) do
		if Has(k) then n = n + 1 end
	end
	return n
end

local function Names(keys, only)
	local out = {}
	for _, k in ipairs(keys) do
		if (only == nil) or (Has(k) == only) then
			table.insert(out, DISPLAY_NAME[TOWER_NAMES[k]] or k)
		end
	end
	return table.concat(out, "、")
end

local function SetOverall(color, text)
	OverallBadge.Text = text
	Tween(OverallBadge, { TextColor3 = color, BackgroundColor3 = color })
	Tween(OverallDot, { BackgroundColor3 = color })
end

local function Evaluate()
	if not dataLoaded then
		for _, def in ipairs(CATEGORY_DEFS) do
			SetCard(def.id, COLORS.gray, "加载中", "正在读取塔数据…")
			for _, k in ipairs(def.units) do
				SetUnit(def.id, k, COLORS.gray, "等待数据")
			end
		end
		SetOverall(COLORS.gray, "加载中")
		return
	end

	local issues = 0

	-- STARTER ------------------------------------------------
	local starterKeys = { "BASIC", "HARVESTER" }
	local starterCount = Count(starterKeys)

	if starterCount == 0 then
		issues = issues + 1
		SetCard("starter", COLORS.red, "缺少 Starter", "至少带 Miracle 或 Harvester 其中一个")
		for _, k in ipairs(starterKeys) do SetUnit("starter", k, COLORS.red, "需要补") end
	else
		local m = (starterCount == 1) and "已带 1 个 · 需要搭配辅助塔" or "已带 2 个 · 不需要辅助塔"
		SetCard("starter", COLORS.green, "OK", m)
		for _, k in ipairs(starterKeys) do
			if Has(k) then
				SetUnit("starter", k, COLORS.green, "已带")
			else
				SetUnit("starter", k, COLORS.gray, "未带 · 可选")
			end
		end
	end

	-- DAMAGE -------------------------------------------------
	local damageKeys = { "KING", "GOJO" }
	local damageCount = Count(damageKeys)

	if damageCount == 2 then
		SetCard("damage", COLORS.green, "OK", "两个输出塔都已带齐")
		for _, k in ipairs(damageKeys) do SetUnit("damage", k, COLORS.green, "已带") end
	else
		issues = issues + 1
		SetCard("damage", COLORS.red, "缺少输出", "必须两个都带，还缺：" .. Names(damageKeys, false))
		for _, k in ipairs(damageKeys) do
			if Has(k) then
				SetUnit("damage", k, COLORS.green, "已带")
			else
				SetUnit("damage", k, COLORS.red, "需要补")
			end
		end
	end

	-- FARM ---------------------------------------------------
	local farmKeys = { "TREE", "FROST", "PINATA", "KOGANE", "CHEAP" }
	local farmCount = Count(farmKeys)

	if farmCount == 0 then
		issues = issues + 1
		SetCard("farm", COLORS.red, "缺少农场", "必须带 1 个农场塔（只能带一个）")
		for _, k in ipairs(farmKeys) do SetUnit("farm", k, COLORS.red, "未带") end
	elseif farmCount > 1 then
		issues = issues + 1
		SetCard("farm", COLORS.red, "带多了", "农场塔只能带一个，请卸下多余的：" .. Names(farmKeys, true))
		for _, k in ipairs(farmKeys) do
			if Has(k) then
				SetUnit("farm", k, COLORS.red, "多余 · 请卸下")
			else
				SetUnit("farm", k, COLORS.gray, "未带")
			end
		end
	else
		if Has("KOGANE") and not Has("KING") then
			issues = issues + 1
			SetCard("farm", COLORS.red, "Kogane 无绑定", "Kogane 需要绑定 KingOfCursesEvo，请补带")
		else
			local extra = Has("KOGANE") and "已带 Kogane · 已绑定 KingOfCursesEvo" or ("已带：" .. Names(farmKeys, true))
			SetCard("farm", COLORS.green, "OK", extra)
		end
		for _, k in ipairs(farmKeys) do
			if Has(k) then
				if k == "KOGANE" and not Has("KING") then
					SetUnit("farm", k, COLORS.red, "缺少 King 绑定")
				else
					SetUnit("farm", k, COLORS.green, "已带")
				end
			else
				SetUnit("farm", k, COLORS.gray, "未带")
			end
		end
	end

	-- SUPPORT ------------------------------------------------
	local supportKeys = { "STRONGEST", "B85" }
	local supportCount = Count(supportKeys)

	if starterCount == 0 then
		SetCard("support", COLORS.gray, "待定", "先补齐 Starter，再判断是否需要辅助塔")
		for _, k in ipairs(supportKeys) do
			SetUnit("support", k, Has(k) and COLORS.green or COLORS.gray, Has(k) and "已带" or "未带")
		end
	elseif starterCount == 1 then
		if supportCount >= 1 then
			SetCard("support", COLORS.green, "OK", "只带 1 个 Starter · 辅助已带：" .. Names(supportKeys, true))
			for _, k in ipairs(supportKeys) do
				SetUnit("support", k, Has(k) and COLORS.green or COLORS.gray, Has(k) and "已带" or "未带")
			end
		else
			issues = issues + 1
			SetCard("support", COLORS.red, "缺少辅助", "只带了 1 个 Starter，需要补一个辅助塔")
			for _, k in ipairs(supportKeys) do SetUnit("support", k, COLORS.red, "需要补") end
		end
	else
		if supportCount >= 1 then
			SetCard("support", COLORS.amber, "无需辅助", "已带 2 个 Starter，可卸下：" .. Names(supportKeys, true))
			for _, k in ipairs(supportKeys) do
				SetUnit("support", k, Has(k) and COLORS.amber or COLORS.gray, Has(k) and "不需要 · 可卸下" or "未带")
			end
		else
			SetCard("support", COLORS.green, "OK", "已带 2 个 Starter，不需要辅助塔")
			for _, k in ipairs(supportKeys) do SetUnit("support", k, COLORS.gray, "无需") end
		end
	end

	-- Overall ------------------------------------------------
	if issues == 0 then
		SetOverall(COLORS.green, "配置正常")
	else
		SetOverall(COLORS.red, issues .. " 项问题")
	end
end

-- Live stats -------------------------------------------------
local function FormatNumber(n)
	n = tonumber(n) or 0
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""))
end

local function UpdateStats()
	StatMap.Text = DetectMap() or "Lobby"

	local wave = "-"
	pcall(function()
		local info = Workspace:FindFirstChild("Info")
		local w = info and info:FindFirstChild("Wave")
		if w then wave = tostring(w.Value) end
	end)
	StatWave.Text = wave

	StatTimer.Text = IsInGame() and GetTimerText() or "-"

	pcall(function() StatGold.Text = FormatNumber(Gold.Value) end)

	local stateText, stateColor
	if IsInGame() and IsEndScreenVisible() then
		stateText, stateColor = "EXITING", COLORS.amber
	elseif _G.stopAll then
		stateText, stateColor = "STOPPED", COLORS.red
	elseif not IsInGame() then
		stateText = LobbyState.target and "JOINING" or "LOBBY"
		stateColor = COLORS.accent
	elseif not _G.miraclePhaseComplete then
		stateText, stateColor = "MIRACLE", COLORS.amber
	else
		stateText, stateColor = "PLACING", COLORS.green
	end
	StatState.Text = stateText
	StatState.TextColor3 = stateColor
end

