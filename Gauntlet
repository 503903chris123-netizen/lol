local function RebuildEquipChips()
    local list = {}
    for _, key in ipairs(EQUIP_ORDER) do
        local name = TOWER_NAMES[key]
        if equippedSet[name] then
            table.insert(list, name)
        end
    end

    local sig = table.concat(list, ",") .. (dataLoaded and "|1" or "|0")
    if sig == equipSignature then return end
    equipSignature = sig

    for _, c in ipairs(EquipGrid:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end

    for i, name in ipairs(list) do
        local chip = New("Frame", {
            BackgroundColor3 = COLORS.unit,
            BorderSizePixel = 0,
            LayoutOrder = i,
        }, EquipGrid)
        Corner(chip, 8)
        Stroke(chip, COLORS.green, 1, 0.6)

        local dot = New("Frame", {
            Size = UDim2.new(0, 6, 0, 6),
            Position = UDim2.new(0, 8, 0.5, -3),
            BackgroundColor3 = COLORS.green,
            BorderSizePixel = 0,
        }, chip)
        Corner(dot, 3)

        local l = Label(chip, DISPLAY_NAME[name] or name, 11, COLORS.text, Enum.Font.GothamMedium)
        l.Position = UDim2.new(0, 22, 0, 0)
        l.Size = UDim2.new(1, -26, 1, 0)
        l.TextTruncate = Enum.TextTruncate.AtEnd
    end

    EquipBadge.Text = dataLoaded and (#list .. " 个") or "加载中"
    local col = (dataLoaded and #list > 0) and COLORS.accent or COLORS.gray
    EquipBadge.TextColor3 = col
    EquipBadge.BackgroundColor3 = col
    EquipBadgeStroke.Color = col

    if not dataLoaded then
        EquipEmpty.Text = "正在读取已带塔…"
        EquipEmpty.Visible = true
    elseif #list == 0 then
        EquipEmpty.Text = "按名字没有获取到任何塔"
