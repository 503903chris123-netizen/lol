--========================================================--
-- TOWER HELPERS
--========================================================--

local function GetTowerLevel(tower)
    local attr = tower:GetAttribute("Level")
    if typeof(attr) == "number" then return attr end

    local levelValue = tower:FindFirstChild("Level") or tower:FindFirstChild("level")
    if levelValue and tonumber(levelValue.Value) then
        return tonumber(levelValue.Value)
    end

    local level = tonumber(string.match(tower.Name, "%d+"))
    return level or 1
end

local function GetTowersByName(name)
    local towers = Workspace:FindFirstChild("Towers")
    if not towers then return {} end

    local result = {}
    for _, t in ipairs(towers:GetChildren()) do
        if NameMatches(t.Name, name) then
            table.insert(result, t)
        end
    end
    return result
end

local function AllMiracleAtLeast(level)
    local miracles = GetTowersByName(TOWER_NAMES.BASIC)
    if #miracles < 2 then return false end
    for _, t in ipairs(miracles) do
        if GetTowerLevel(t) < level then return false end
    end
    return true
end

local function GetKingTower()
    local kings = GetTowersByName(TOWER_NAMES.KING)
    return kings[1]
end

--========================================================--
-- PLACE TOWER
--========================================================--

local function PlaceTower(nameKey)
    if _G.stopAll then return false end

    local towerName = TOWER_NAMES[nameKey]
    if not towerName then return false end

    -- 有什么放什么: 按名字获取不到(没带)的塔直接跳过
    if dataLoaded and not equippedSet[towerName] then
        return false
    end

    -- FrostBlossom: 固定 UUID / 固定位置
    if nameKey == "FROST" then
        local ok, ret = pcall(function()
            return SpawnNewTower:InvokeServer(FROST_BLOSSOM_UUID, FROST_BLOSSOM_CFRAME)
        end)
        if ok and ret then
            _G.frostPlaced = true
            return true
        end
        return false
    end

    -- Kogane: 固定 UUID / 固定位置 / 第三个参数绑定 KingOfCursesEvo
    if nameKey == "KOGANE" then
        local king = GetKingTower()
        if not king then return false end

        local ok, ret = pcall(function()
            return SpawnNewTower:InvokeServer(KOGANE_UUID, KOGANE_CFRAME, king)
        end)
        return ok and ret and true or false
    end

    -- 普通塔 (含 Pinata)
    local posTable = GetPositions()
    if not posTable then return false end

    local pos = posTable[nameKey]
    if not pos then return false end

    local uuid
    if nameKey == "PINATA" and PINATA_UUID then
        uuid = PINATA_UUID
    else
        uuid = ResolveUUID(towerName)
        if not uuid then
            RefreshTowerData(true)
            uuid = ResolveUUID(towerName)
            if not uuid then return false end
        end
    end

    local ok, ret = pcall(function()
        return SpawnNewTower:InvokeServer(uuid, pos)
    end)

    if not ok or not ret then
        uuidCache[towerName] = nil
        return false
    end

    task.spawn(function()
        task.wait(0.1)
        pcall(function()
            local towersFolder = Workspace:FindFirstChild("Towers")
            if not towersFolder then return end

            for _, t in ipairs(towersFolder:GetChildren()) do
                if NameMatches(t.Name, towerName) then
                    for _ = 1, 3 do
                        ChangeTowerMode:InvokeServer(t)
                        task.wait(0.1)
                    end
                    break
                end
            end
        end)
    end)

    return true
end

