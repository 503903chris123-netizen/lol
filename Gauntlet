local function ProcessFlowInner()
	if _G.stopAll then return end
	if not IsInGame() then return end

	if environment.Stage == 0 then
		-- 没带 Miracle 就直接跳过 Miracle 阶段, 有什么放什么
		if dataLoaded and not equippedSet[TOWER_NAMES.BASIC] then
			_G.miraclePhaseComplete = true
			environment.Stage = 1
			print("[系统] 未带 Miracle, 跳过 Miracle 阶段")
			return
		end

		ProcessMiracle()

		local miracles = GetTowersByName(TOWER_NAMES.BASIC)
		if #miracles >= 2 then
			environment.Stage = 1
			print("[系统] 已有2个 Miracle")
		end
		return
	end

	if not _G.miraclePhaseComplete then return end

	SpamPlaceOthers()
end

local flowBusy = false
local function ProcessFlow()
	if flowBusy then return end
	flowBusy = true
	pcall(ProcessFlowInner)
	flowBusy = false
end

