--========================================================--
-- UUID CACHE / EQUIPPED DETECTION (by name)
--========================================================--

local uuidCache = {}
local equippedSet = {}     -- [towerName] = true  (按名字能获取到 = 已带)
local dataLoaded = false
local lastRefresh = 0

local function RefreshTowerData(force)
	local now = tick()

	if not force and now - lastRefresh < 3 then
		return dataLoaded
	end

	local ok, data = pcall(function()
		return GetAllData:InvokeServer()
	end)

	if not ok or type(data) ~= "table" or type(data.Towers) ~= "table" then
		return false
	end

	lastRefresh = now

	-- 是否存在 Equipped 字段 (没有的话, 按名字能找到就算已带)
	local hasFlag = false
	for _, t in pairs(data.Towers) do
		if type(t) == "table" and t.Equipped ~= nil then
			hasFlag = true
			break
		end
	end

	local newEquipped = {}
	local newUUID = {}
	local newUUIDIsEquipped = {}

	for _, t in pairs(data.Towers) do
		if type(t) == "table" and t.Name and t.UUID then
			for _, base in pairs(TOWER_NAMES) do
				if NameMatches(t.Name, base) then
					local isEq = (not hasFlag) or (t.Equipped == true)
					if isEq then
						newEquipped[base] = true
					end
					if not newUUID[base] or (isEq and not newUUIDIsEquipped[base]) then
						newUUID[base] = t.UUID
						newUUIDIsEquipped[base] = isEq
					end
				end
			end
		end
	end

	uuidCache = newUUID
	equippedSet = newEquipped
	dataLoaded = true
	return true
end

local function ResolveUUID(towerName)
	if not uuidCache[towerName] then
		RefreshTowerData(true)
	end
	return uuidCache[towerName]
end

task.spawn(function()
	while not RefreshTowerData(true) do
		task.wait(1)
	end
	while task.wait(5) do
		pcall(RefreshTowerData, true)
	end
end)

