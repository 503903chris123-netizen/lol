-- workspace.Info.Time.Timer.Value -> "m:ss" (数字) 或原样文字
local function GetTimerText()
	local info = Workspace:FindFirstChild("Info")
	local t = info and info:FindFirstChild("Time")
	local timer = t and t:FindFirstChild("Timer")
	if not timer then return "-" end

	local ok, v = pcall(function() return timer.Value end)
	if not ok or v == nil then return "-" end

	if type(v) == "number" then
		local total = math.max(0, math.floor(v))
		return string.format("%d:%02d", math.floor(total / 60), total % 60)
	end
	return tostring(v)
end

--========================================================--
-- LOBBY: 自动检测局内 / 局外
--  局内 (检测到 Workspace.Map 里的地图): 放塔、升级 (上面的逻辑)
--  局外 (没有检测到地图): 找 PlayerCount 为 0/N 的空传送器 -> 瞬间 TP 进去
--        -> 绕圈 tween 让传送器检测到 -> 循环 ChooseStage + Start
--========================================================--

local LOBBY_TP_OFFSET = Vector3.new(0, 3, 0)  -- 传送到传送器中心上方的偏移, 站位不对就改这里
local CIRCLE_RADIUS = 4.5                        -- 绕圈半径
local CIRCLE_STEPS = 12                        -- 绕一圈的段数
local CIRCLE_STEP_TIME = 0.08                  -- 每段 tween 时间
local JOIN_TIMEOUT = 6                         -- 进了这么久还在大厅就重新传送 / 换传送器

local LobbyState = { status = "等待中", target = nil, joinedAt = 0 }

-- 传送器按名字里的数字排序 (Elevator2 在 Elevator10 前面)
local function GetElevators()
	local folder = Workspace:FindFirstChild("Gauntletteleporters")
	if not folder then return {} end

	local list = folder:GetChildren()
	table.sort(list, function(a, b)
		local na = tonumber(string.match(a.Name, "%d+")) or 0
		local nb = tonumber(string.match(b.Name, "%d+")) or 0
		if na ~= nb then return na < nb end
		return a.Name < b.Name
	end)
	return list
end

-- Billboard.BillboardGui.PlayerCount.Text (找不到就在子孙里按名字找)
local function GetCountText(elev)
	local label
	pcall(function() label = elev.Billboard.BillboardGui.PlayerCount end)
	if not label then
		label = elev:FindFirstChild("PlayerCount", true)
	end
	if not label then return nil end

	local ok, text = pcall(function() return label.Text end)
	if ok and type(text) == "string" then
		return (text:gsub("<[^>]+>", ""))  -- 去掉富文本标签
	end
	return nil
end

-- "0/4" = 空
local function IsEmptyText(text)
	if not text then return false end
	return string.match(text, "^%s*0%s*/%s*%d+") ~= nil
end

local function GetRoot()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

-- 瞬间 TP 到传送器, 然后绕圈 tween 让传送器检测到玩家进入
local function TeleportInto(elev)
	local root = GetRoot()
	if not root then return false end

	local okPivot, pivot = pcall(function() return elev:GetPivot() end)
	if not okPivot or not pivot then return false end

	local center = pivot.Position + LOBBY_TP_OFFSET
	pcall(function() root.CFrame = CFrame.new(center) end)

	for i = 1, CIRCLE_STEPS do
		if IsInGame() then return true end
		root = GetRoot()
		if not root then return false end

		local ang = (i / CIRCLE_STEPS) * math.pi * 2
		local pos = center + Vector3.new(math.cos(ang) * CIRCLE_RADIUS, 0, math.sin(ang) * CIRCLE_RADIUS)
		local ok = pcall(function()
			local tw = TweenService:Create(root, TweenInfo.new(CIRCLE_STEP_TIME, Enum.EasingStyle.Linear), {
				CFrame = CFrame.new(pos),
			})
			tw:Play()
			tw.Completed:Wait()
		end)
		if not ok then return false end
	end

	root = GetRoot()
	if root then
		pcall(function() root.CFrame = CFrame.new(center) end)
	end
	return true
end

-- 每局重置状态 (Wave 50 停止后回到大厅, 下一局要重新开始放塔)
local function ResetRunState()
	waveTriggered = false
	_G.stopAll = false
	_G.miraclePhaseComplete = false
	_G.autoSkipCalled = false
	_G.upgradeBlocked = false
	environment.Stage = 0
end

local function LobbyStep()
	local gauntlet = Remotes:FindFirstChild("GauntletTeleporters")
	local choose = gauntlet and gauntlet:FindFirstChild("ChooseStage")
	local start = gauntlet and gauntlet:FindFirstChild("Start")
	if not (choose and start) then
		LobbyState.status = "找不到 GauntletTeleporters 远程"
		return
	end

	local elevators = GetElevators()
	if #elevators == 0 then
		LobbyState.status = "等待传送器加载"
		return
	end

	local target = LobbyState.target
	local needPick = (not target) or (not target.Parent)
	local timedOut = target and target.Parent and (tick() - LobbyState.joinedAt > JOIN_TIMEOUT)

	if needPick or timedOut then
		local pick
		for _, e in ipairs(elevators) do
			if IsEmptyText(GetCountText(e)) then
				pick = e
				break
			end
		end

		-- 超时且没有别的空传送器: 继续用当前这个, 重新 TP 一次
		if not pick and timedOut then
			pick = target
		end

		if not pick then
			LobbyState.target = nil
			LobbyState.status = "没有空传送器, 等待中"
			return
		end

		LobbyState.target = pick
		LobbyState.joinedAt = tick()
		LobbyState.status = "传送到 " .. pick.Name
		if not TeleportInto(pick) then
			LobbyState.target = nil
			return
		end
	end

	target = LobbyState.target
	if not target then return end

	LobbyState.status = "进入 " .. target.Name .. " · 开始游戏"
	pcall(function() choose:FireServer(target, true) end)
	pcall(function() start:FireServer(target) end)
end

task.spawn(function()
	local wasInGame = nil
	while task.wait(0.1) do
		local inGame = IsInGame()

		if inGame ~= wasInGame then
			wasInGame = inGame
			ResetRunState()
			LobbyState.target = nil
			LobbyState.status = inGame and "游戏中" or "大厅"
		end

		if not inGame then
			pcall(LobbyStep)
		end
	end
end)

