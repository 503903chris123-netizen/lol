-- 放置数量 + 等级 --------------------------------------------
local function GetPlacedInfo(towerName)
	local list = GetTowersByName(towerName)
	local levels = {}
	for _, t in ipairs(list) do
		table.insert(levels, GetTowerLevel(t))
	end
	table.sort(levels)
	return #list, levels
end

local function UpdatePlacement()
	for _, def in ipairs(CATEGORY_DEFS) do
		for _, key in ipairs(def.units) do
			local u = cards[def.id].units[key]
			local towerName = TOWER_NAMES[key]
			local equipped = (not dataLoaded) or equippedSet[towerName]

			if not equipped then
				u.count.Text = ""
				u.levels.Text = ""
				u.name.TextColor3 = COLORS.dim
			else
				u.name.TextColor3 = COLORS.text
				local n, levels = GetPlacedInfo(towerName)
				u.count.Text = tostring(n)
				u.count.TextColor3 = (n > 0) and COLORS.text or COLORS.dim

				if n == 0 then
					u.levels.Text = "未放置"
					u.levels.TextColor3 = COLORS.dim
				else
					local parts = {}
					for _, lv in ipairs(levels) do
						table.insert(parts, "Lv" .. lv)
					end
					u.levels.Text = table.concat(parts, "｜")
					u.levels.TextColor3 = COLORS.accent
				end
			end
		end
	end
end

-- Evaluation -------------------------------------------------
local function Has(key)
	return equippedSet[TOWER_NAMES[key]] == true
end

local function Count(keys)
	local n = 0
	for _, k in ipairs(keys) do
		if Has(k) then n = n + 1 end
	end
	return n
end

local function Names(keys, only)
	local out = {}
	for _, k in ipairs(keys) do
		if (only == nil) or (Has(k) == only) then
			table.insert(out, DISPLAY_NAME[TOWER_NAMES[k]] or k)
		end
	end
	return table.concat(out, "、")
end

