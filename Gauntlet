--========================================================--
-- UPGRADE
--========================================================--

local function UpgradeLoop()
	if _G.stopAll then return end

	local towersFolder = Workspace:FindFirstChild("Towers")
	if not towersFolder then return end

	local miracles = {}
	for _, t in ipairs(towersFolder:GetChildren()) do
		if NameMatches(t.Name, TOWER_NAMES.BASIC) then
			table.insert(miracles, t)
		end
	end

	-- Miracle 阶段
	if not _G.miraclePhaseComplete then
		if #miracles < 2 then return end

		table.sort(miracles, function(a, b)
			return GetTowerLevel(a) < GetTowerLevel(b)
		end)

		for _, tower in ipairs(miracles) do
			if GetTowerLevel(tower) < 4 then
				pcall(function() UpgradeTower:InvokeServer(tower) end)
				return
			end
		end

		if AllMiracleAtLeast(4) then
			_G.miraclePhaseComplete = true
			print("[系统] Miracle Phase 完成")
		end
		return
	end

	-- 其他塔升级
	for _, tower in ipairs(towersFolder:GetChildren()) do
		local isBasic = NameMatches(tower.Name, TOWER_NAMES.BASIC)
		if (not isBasic) or GetTowerLevel(tower) < 4 then
			local affected =
				NameMatches(tower.Name, TOWER_NAMES.B85)
				or NameMatches(tower.Name, TOWER_NAMES.GOJO)
				or NameMatches(tower.Name, TOWER_NAMES.KING)
				or NameMatches(tower.Name, TOWER_NAMES.HARVESTER)
				or NameMatches(tower.Name, TOWER_NAMES.TREE)
				or NameMatches(tower.Name, TOWER_NAMES.KOGANE)

			if not (_G.upgradeBlocked and affected) then
				pcall(function() UpgradeTower:InvokeServer(tower) end)
			end
		end
	end
end

task.spawn(function()
	while task.wait(0.3) do
		if IsInGame() and not _G.stopAll then
			pcall(UpgradeLoop)
		end
	end
end)

