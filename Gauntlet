local function Evaluate()
	if not dataLoaded then
		for _, def in ipairs(CATEGORY_DEFS) do
			SetCard(def.id, COLORS.gray, "加载中", "正在读取塔数据…")
			for _, k in ipairs(def.units) do
				SetUnit(def.id, k, COLORS.gray, "等待数据")
			end
		end
		SetOverall(COLORS.gray, "加载中")
		return
	end

	local issues = 0

	-- STARTER ------------------------------------------------
	local starterKeys = { "BASIC", "HARVESTER" }
	local starterCount = Count(starterKeys)

	if starterCount == 0 then
		issues = issues + 1
		SetCard("starter", COLORS.red, "缺少 Starter", "至少带 Miracle 或 Harvester 其中一个")
		for _, k in ipairs(starterKeys) do SetUnit("starter", k, COLORS.red, "需要补") end
	else
		local m = (starterCount == 1) and "已带 1 个 · 需要搭配辅助塔" or "已带 2 个 · 不需要辅助塔"
		SetCard("starter", COLORS.green, "OK", m)
		for _, k in ipairs(starterKeys) do
			if Has(k) then
				SetUnit("starter", k, COLORS.green, "已带")
			else
				SetUnit("starter", k, COLORS.gray, "未带 · 可选")
			end
		end
	end

	-- DAMAGE -------------------------------------------------
	local damageKeys = { "KING", "GOJO" }
	local damageCount = Count(damageKeys)

	if damageCount == 2 then
		SetCard("damage", COLORS.green, "OK", "两个输出塔都已带齐")
		for _, k in ipairs(damageKeys) do SetUnit("damage", k, COLORS.green, "已带") end
	else
		issues = issues + 1
		SetCard("damage", COLORS.red, "缺少输出", "必须两个都带，还缺：" .. Names(damageKeys, false))
		for _, k in ipairs(damageKeys) do
			if Has(k) then
				SetUnit("damage", k, COLORS.green, "已带")
			else
				SetUnit("damage", k, COLORS.red, "需要补")
			end
		end
	end

	-- FARM ---------------------------------------------------
	local farmKeys = { "TREE", "FROST", "PINATA", "KOGANE", "CHEAP" }
	local farmCount = Count(farmKeys)

	if farmCount == 0 then
		issues = issues + 1
		SetCard("farm", COLORS.red, "缺少农场", "必须带 1 个农场塔（只能带一个）")
		for _, k in ipairs(farmKeys) do SetUnit("farm", k, COLORS.red, "未带") end
	elseif farmCount > 1 then
		issues = issues + 1
		SetCard("farm", COLORS.red, "带多了", "农场塔只能带一个，请卸下多余的：" .. Names(farmKeys, true))
		for _, k in ipairs(farmKeys) do
			if Has(k) then
				SetUnit("farm", k, COLORS.red, "多余 · 请卸下")
			else
				SetUnit("farm", k, COLORS.gray, "未带")
			end
		end
	else
		if Has("KOGANE") and not Has("KING") then
			issues = issues + 1
			SetCard("farm", COLORS.red, "Kogane 无绑定", "Kogane 需要绑定 KingOfCursesEvo，请补带")
		else
			local extra = Has("KOGANE") and "已带 Kogane · 已绑定 KingOfCursesEvo" or ("已带：" .. Names(farmKeys, true))
			SetCard("farm", COLORS.green, "OK", extra)
		end
		for _, k in ipairs(farmKeys) do
			if Has(k) then
				if k == "KOGANE" and not Has("KING") then
					SetUnit("farm", k, COLORS.red, "缺少 King 绑定")
				else
					SetUnit("farm", k, COLORS.green, "已带")
				end
			else
				SetUnit("farm", k, COLORS.gray, "未带")
			end
		end
	end

	-- SUPPORT ------------------------------------------------
	local supportKeys = { "STRONGEST", "B85" }
	local supportCount = Count(supportKeys)

	if starterCount == 0 then
		SetCard("support", COLORS.gray, "待定", "先补齐 Starter，再判断是否需要辅助塔")
		for _, k in ipairs(supportKeys) do
			SetUnit("support", k, Has(k) and COLORS.green or COLORS.gray, Has(k) and "已带" or "未带")
		end
	elseif starterCount == 1 then
		if supportCount >= 1 then
			SetCard("support", COLORS.green, "OK", "只带 1 个 Starter · 辅助已带：" .. Names(supportKeys, true))
			for _, k in ipairs(supportKeys) do
				SetUnit("support", k, Has(k) and COLORS.green or COLORS.gray, Has(k) and "已带" or "未带")
			end
		else
			issues = issues + 1
			SetCard("support", COLORS.red, "缺少辅助", "只带了 1 个 Starter，需要补一个辅助塔")
			for _, k in ipairs(supportKeys) do SetUnit("support", k, COLORS.red, "需要补") end
		end
	else
		if supportCount >= 1 then
			SetCard("support", COLORS.amber, "无需辅助", "已带 2 个 Starter，可卸下：" .. Names(supportKeys, true))
			for _, k in ipairs(supportKeys) do
				SetUnit("support", k, Has(k) and COLORS.amber or COLORS.gray, Has(k) and "不需要 · 可卸下" or "未带")
			end
		else
			SetCard("support", COLORS.green, "OK", "已带 2 个 Starter，不需要辅助塔")
			for _, k in ipairs(supportKeys) do SetUnit("support", k, COLORS.gray, "无需") end
		end
	end

	-- Overall ------------------------------------------------
	if issues == 0 then
		SetOverall(COLORS.green, "配置正常")
	else
		SetOverall(COLORS.red, issues .. " 项问题")
	end
end

-- Live stats -------------------------------------------------
local function FormatNumber(n)
	n = tonumber(n) or 0
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""))
end

local function UpdateStats()
	StatMap.Text = DetectMap() or "Lobby"

	local wave = "-"
	pcall(function()
		local info = Workspace:FindFirstChild("Info")
		local w = info and info:FindFirstChild("Wave")
		if w then wave = tostring(w.Value) end
	end)
	StatWave.Text = wave

	pcall(function() StatGold.Text = FormatNumber(Gold.Value) end)

	local stateText, stateColor
	if _G.stopAll then
		stateText, stateColor = "STOPPED", COLORS.red
	elseif not IsInGame() then
		stateText, stateColor = "IDLE", COLORS.gray
	elseif not _G.miraclePhaseComplete then
		stateText, stateColor = "MIRACLE", COLORS.amber
	else
		stateText, stateColor = "PLACING", COLORS.green
	end
	StatState.Text = stateText
	StatState.TextColor3 = stateColor
end

task.spawn(function()
	while task.wait(0.5) do
		pcall(UpdateStats)
		pcall(Evaluate)
		pcall(UpdatePlacement)
	end
end)

pcall(UpdateStats)
pcall(Evaluate)
pcall(UpdatePlacement)

-- Minimize / drag ---------------------------------------------
local minimized = false
MinBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	MinBtn.Text = minimized and "+" or "–"
	Scroll.Visible = not minimized
	Strip.Visible = not minimized
	Tween(Main, { Size = UDim2.new(0, MAIN_W, 0, minimized and HEADER_H or FULL_H) }, 0.3)
end)

do
	local dragging, dragStart, startPos
	Header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = Main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			Main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.RightControl then
		SetUiVisible(not uiOpen)
	end
end)

SetUiVisible(true)

