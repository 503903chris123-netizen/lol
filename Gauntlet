-- 名字严格匹配: 名字后面只允许跟数字/空格/下划线/括号等, 避免把 Evo 和非 Evo 搞混
local function NameMatches(instName, base)
	local n = string.lower(tostring(instName))
	local b = string.lower(base)
	if string.sub(n, 1, #b) ~= b then
		return false
	end
	return string.match(string.sub(n, #b + 1), "^[%s%d_%-%.%(%)]*$") ~= nil
end

