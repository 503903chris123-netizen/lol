--========================================================--
-- TOWER HELPERS
--========================================================--

local function GetTowerLevel(tower)
	local attr = tower:GetAttribute("Level")
	if typeof(attr) == "number" then return attr end

	local levelValue = tower:FindFirstChild("Level") or tower:FindFirstChild("level")
	if levelValue and tonumber(levelValue.Value) then
		return tonumber(levelValue.Value)
	end

	local level = tonumber(string.match(tower.Name, "%d+"))
	return level or 1
end

local function GetTowersByName(name)
	local towers = Workspace:FindFirstChild("Towers")
	if not towers then return {} end

	local result = {}
	for _, t in ipairs(towers:GetChildren()) do
		if NameMatches(t.Name, name) then
			table.insert(result, t)
		end
	end
	return result
end

local function AllMiracleAtLeast(level)
	local miracles = GetTowersByName(TOWER_NAMES.BASIC)
	if #miracles < 2 then return false end
	for _, t in ipairs(miracles) do
		if GetTowerLevel(t) < level then return false end
	end
	return true
end

local function GetKingTower()
	local kings = GetTowersByName(TOWER_NAMES.KING)
	return kings[1]
end

--========================================================--
-- PLACE TOWER
--========================================================--

-- 目标数量: 没到目标就补 (包括塔被删后), 到了就不放. Wave 50 后 _G.stopAll 会停止一切.
local TARGET_COUNT = {
	BASIC     = 2,  -- Miracle
	HARVESTER = 1,
	KING      = 1,  -- KingOfCursesEvo
	GOJO      = 1,  -- StrongestSorcererEvo
	TREE      = 1,
	FROST     = 1,
	PINATA    = 1,
	KOGANE    = 1,
	STRONGEST = 1,  -- 辅助
	B85       = 1,  -- 辅助 (KingOfCursesFrost)
	CHEAP     = 4,  -- SorcererAgent (farm 类型, 4 个)
}

-- 放置成功后塔出现在 Workspace 需要一点时间, 冷却期内不重复放, 防止超出目标数量
local lastPlaced = {}
local PLACE_COOLDOWN = 0.5

-- 农场塔 (TreeOfLife / FrostBlossom / Pinata / Kogane) 的 UUID 取自 LocalPlayer.Equipped5.Value
local FARM_KEYS = { TREE = true, FROST = true, PINATA = true, KOGANE = true, CHEAP = true }

local function GetFarmUUID()
	local v = LocalPlayer:FindFirstChild("Equipped5")
	local val = v and v.Value
	if type(val) == "string" and val ~= "" then
		return val
	end
	return nil
end

local function PlaceTower(nameKey)
	if _G.stopAll then return false end

	local towerName = TOWER_NAMES[nameKey]
	if not towerName then return false end

	-- 有什么放什么: 按名字获取不到(没带)的塔直接跳过
	if dataLoaded and not equippedSet[towerName] then
		return false
	end

	-- 目标数量: 已达到就不放, 没到(或被删了)就补
	local target = TARGET_COUNT[nameKey] or 1
	if #GetTowersByName(towerName) >= target then
		return false
	end
	if tick() - (lastPlaced[nameKey] or 0) < PLACE_COOLDOWN then
		return false
	end

	-- FrostBlossom: 固定 UUID / 固定位置
	if nameKey == "FROST" then
		local farmUUID = GetFarmUUID()
		if not farmUUID then return false end

		local frostCFrame = FROST_BLOSSOM_CFRAME
		if DetectMap() == "JujutsuHigh" then
			local pt = GetPositions()
			if pt and pt.FROST then frostCFrame = pt.FROST end
		end

		local ok, ret = pcall(function()
			return SpawnNewTower:InvokeServer(farmUUID, frostCFrame)
		end)
		if ok and ret then
			_G.frostPlaced = true
			lastPlaced[nameKey] = tick()
			return true
		end
		return false
	end

	-- Kogane: 固定 UUID / 固定位置 / 第三个参数绑定 KingOfCursesEvo
	if nameKey == "KOGANE" then
		local king = GetKingTower()
		if not king then return false end

		local farmUUID = GetFarmUUID()
		if not farmUUID then return false end

		local ok, ret = pcall(function()
			return SpawnNewTower:InvokeServer(farmUUID, KOGANE_CFRAME, king)
		end)
		if ok and ret then
			lastPlaced[nameKey] = tick()
			return true
		end
		return false
	end

	-- 普通塔 (含 Pinata)
	local posTable = GetPositions()
	if not posTable then return false end

	local pos = posTable[nameKey]
	if not pos then return false end

	local uuid
	if FARM_KEYS[nameKey] then
		-- 所有农场塔: UUID 只从 Equipped5.Value 获取
		uuid = GetFarmUUID()
		if not uuid then return false end
	else
		uuid = ResolveUUID(towerName)
		if not uuid then
			RefreshTowerData(true)
			uuid = ResolveUUID(towerName)
			if not uuid then return false end
		end
	end

	local ok, ret = pcall(function()
		return SpawnNewTower:InvokeServer(uuid, pos)
	end)

	if not ok or not ret then
		uuidCache[towerName] = nil
		return false
	end

	lastPlaced[nameKey] = tick()
	return true
end

