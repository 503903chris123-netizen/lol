local function FireAllDomain(baseName, remote)
	local towers = Workspace:FindFirstChild("Towers")
	if not towers then return end

	-- 无数字
	local t = towers:FindFirstChild(baseName)
	if t then
		pcall(function() remote:FireServer(t) end)
	end

	-- 2~7
	for i = 2, 7 do
		local ti = towers:FindFirstChild(baseName .. i)
		if ti then
			pcall(function() remote:FireServer(ti) end)
		end
	end
end

