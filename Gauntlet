    local t = Label(head, title, 14, COLORS.text, Enum.Font.GothamBold)
    t.Size = UDim2.new(0.55, 0, 1, 0)

    local badge = Label(head, "-", 11, COLORS.gray, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
    badge.AnchorPoint = Vector2.new(1, 0.5)
    badge.Position = UDim2.new(1, 0, 0.5, 0)
    badge.Size = UDim2.new(0, 108, 0, 22)
    badge.BackgroundColor3 = COLORS.gray
    badge.BackgroundTransparency = 0.82
    Corner(badge, 11)
    local bstroke = Stroke(badge, COLORS.gray, 1, 0.4)

    return badge, bstroke
end

