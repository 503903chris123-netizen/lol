if not keys
    or next(keys) == nil then

    warn(
        "[密钥系统] 密钥列表为空"
    )

    return

end


-- ============================================================
-- 创建 UI
-- ============================================================

local gui,
      mainFrame,
      inputBox,
      verifyBtn,
      statusLabel,
      toggleFrame,
      qteToggleBtn,
      kingToggleBtn,
      strongToggleBtn,
      justiceToggleBtn,
      updateToggleVisual =
    createUI()


-- ============================================================
-- 状态
-- ============================================================

local qteConnection = nil
local kingConnection = nil
local strongConnection = nil
local justiceConnection = nil
local timerConnection = nil

local expireTime = nil

local isPermanent = false
local isVerified = false

local qteEnabled = false
local kingEnabled = false
local strongEnabled = false
local justiceEnabled = false


-- ============================================================
-- 停止功能
-- ============================================================

local function stopAllFunctions()

    if qteConnection then

        qteConnection:Disconnect()
        qteConnection = nil

    end


    if kingConnection then

        kingConnection:Disconnect()
        kingConnection = nil

    end


    if strongConnection then

        strongConnection:Disconnect()
        strongConnection = nil

    end


    if justiceConnection then

        justiceConnection:Disconnect()
        justiceConnection = nil

    end


    if timerConnection then

        timerConnection:Disconnect()
        timerConnection = nil

    end


    qteEnabled = false
    kingEnabled = false
    strongEnabled = false
    justiceEnabled = false


    updateToggleVisual(qteToggleBtn, false)
    updateToggleVisual(kingToggleBtn, false)
    updateToggleVisual(strongToggleBtn, false)
    updateToggleVisual(justiceToggleBtn, false)

end


-- ============================================================
-- 倒计时
-- ============================================================

local function updateTimer()

    if isPermanent then

        statusLabel.Text =
            "● 密钥状态：永久有效"

        statusLabel.TextColor3 =
            Color3.fromRGB(100, 220, 150)

        return

    end


    if not expireTime then

        statusLabel.Text =
            "● 等待验证..."

        return

    end


    local remaining =
        expireTime - os.time()


    if remaining <= 0 then

        statusLabel.Text =
            "● 密钥已过期"

        statusLabel.TextColor3 =
            Color3.fromRGB(255, 90, 90)


        stopAllFunctions()

        toggleFrame.Visible = false

        isVerified = false

        return

    end


    local hours =
        math.floor(
            remaining / 3600
        )

    local minutes =
        math.floor(
            (remaining % 3600) / 60
        )

    local seconds =
        math.floor(
            remaining % 60
        )


    statusLabel.Text =
        string.format(
            "● 剩余时间：%02d:%02d:%02d",
            hours,
            minutes,
            seconds
        )


    statusLabel.TextColor3 =
        Color3.fromRGB(100, 220, 150)

end


-- ============================================================
-- QTE 开关
-- ============================================================

local function toggleQTE()

    if not isVerified then
        return
    end


    qteEnabled =
        not qteEnabled


    if qteEnabled then

        if qteConnection then

            qteConnection:Disconnect()
            qteConnection = nil

        end


        qteConnection =
            startQTE()


        updateToggleVisual(
            qteToggleBtn,
            true
        )

    else

        if qteConnection then

            qteConnection:Disconnect()
            qteConnection = nil

        end


        updateToggleVisual(
            qteToggleBtn,
            false
        )

    end

end


