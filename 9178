-- ============================================================
-- 密钥
-- ============================================================

local function fetchKeys()

    local success, result = pcall(function()
        return game:HttpGet(KEY_URL)
    end)

    if not success then
        warn("[密钥系统] 无法连接密钥服务器")
        return nil
    end

    return result
end


local function parseKeys(rawData)

    local keys = {}

    for line in rawData:gmatch("[^\r\n]+") do

        if line ~= "" then

            local parts = {}

            for part in line:gmatch("%S+") do
                table.insert(parts, part)
            end

            if #parts >= 2 then

                local key = parts[1]
                local duration = parts[2]

                if duration == "never" then

                    keys[key] = -1

                else

                    local seconds = tonumber(duration)

                    if seconds then
                        keys[key] = seconds
                    end

                end
            end
        end
    end

    return keys
end


local function validateKey(inputKey, keys)

    return keys[inputKey]

end


