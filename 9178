-- ============================================================
-- 验证
-- ============================================================

verifyBtn.MouseButton1Click:Connect(function()

    local inputKey =
        inputBox.Text


    if inputKey == "" then

        statusLabel.Text =
            "● 请输入密钥"

        statusLabel.TextColor3 =
            Color3.fromRGB(255, 180, 80)

        return

    end


    local duration =
        validateKey(
            inputKey,
            keys
        )


    if not duration then

        statusLabel.Text =
            "● 密钥无效"

        statusLabel.TextColor3 =
            Color3.fromRGB(255, 80, 90)

        return

    end


    isVerified = true


    if duration == -1 then

        isPermanent = true
        expireTime = nil

    else

        isPermanent = false

        expireTime =
            os.time() + duration

    end


    inputBox.Visible = false
    verifyBtn.Visible = false


    toggleFrame.Visible = true


    toggleFrame.Position =
        UDim2.new(
            0,
            16,
            0,
            68
        )


    statusLabel.Position =
        UDim2.new(
            0,
            16,
            0,
            250
        )


    -- 默认全部开启
    if not qteEnabled then
        toggleQTE()
    end

    if not kingEnabled then
        toggleKing()
    end

    if not strongEnabled then
        toggleStrong()
    end

    if not justiceEnabled then
        toggleJustice()
    end


    if timerConnection then

        timerConnection:Disconnect()

    end


    timerConnection =
        RunService.Heartbeat:Connect(
            updateTimer
        )


    updateTimer()

end)


-- ============================================================
-- 启动
-- ============================================================

statusLabel.Text =
    "● 等待输入密钥"

statusLabel.TextColor3 =
    Color3.fromRGB(115, 125, 140)
