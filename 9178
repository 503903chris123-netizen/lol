-- King 领域 (DomainActive)
local KingDomain = Remotes and Remotes:FindFirstChild("Towers") and Remotes.Towers:FindFirstChild("KingOfCursesEvo") and Remotes.Towers.KingOfCursesEvo:FindFirstChild("DomainActive")

-- Strongest (Gojo) 领域 (GojoDomain)
