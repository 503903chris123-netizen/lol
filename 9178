-- Justice 领域 (Domain)
local JusticeDomain = Remotes and Remotes:FindFirstChild("Towers") and Remotes.Towers:FindFirstChild("JusticeSorcerer") and Remotes.Towers.JusticeSorcerer:FindFirstChild("Domain")


-- ============================================================
-- 获取塔实例 (自动匹配等级)
-- ============================================================

local function GetTower(towerName)
    local towers = Workspace:FindFirstChild("Towers")
    if not towers then return nil end

    -- 如果是 StrongestSorcererEvo，需要自动匹配等级
    if towerName == "StrongestSorcererEvo" then
        local found = nil
        local highestLevel = 0
        for _, tower in ipairs(towers:GetChildren()) do
            if tower.Name:find("StrongestSorcererEvo") then
                local level = tonumber(string.match(tower.Name, "%d+")) or 0
                if level > highestLevel then
                    highestLevel = level
                    found = tower
                end
            end
        end
        return found
    end

    -- 其他塔直接匹配名称
    for _, tower in ipairs(towers:GetChildren()) do
        if tower.Name:find(towerName) then
            return tower
        end
    end
    return nil
end


-- ============================================================
-- 自动 QTE (误差0.05 + 间隔0.3秒)
-- ============================================================

local function startQTE()

    local QTE =
        LocalPlayer:FindFirstChild("QTE")

    if not QTE then
        return nil
    end


    local ZonePos =
        QTE:FindFirstChild("ZonePos")

    local ZoneWidth =
        QTE:FindFirstChild("ZoneWidth")

    local MarkerPos =
        QTE:FindFirstChild("MarkerPos")

    local Click =
        QTE:FindFirstChild("Click")


    if not ZonePos
        or not ZoneWidth
        or not MarkerPos
        or not Click then

        return nil

    end


    local lastClickTime = 0
    local QTE_COOLDOWN = 0.3
    local QTE_TOLERANCE = 0.05


    local connection


    connection =
        RunService.Heartbeat:Connect(function()

            if not QTE.Parent then

                connection:Disconnect()

                return

            end


            local marker =
                tonumber(MarkerPos.Value)

            local zone =
                tonumber(ZonePos.Value)


            if not marker or not zone then

                return

            end


            local diff =
                math.abs(marker - zone)


            if diff <= QTE_TOLERANCE then

                local now = tick()

                if now - lastClickTime >= QTE_COOLDOWN then

                    pcall(function()

                        if Click:IsA("RemoteEvent") then

                            Click:FireServer()

                        elseif Click:IsA("BindableFunction") then

                            Click:Invoke()

                        elseif Click:IsA("BindableEvent") then

                            Click:Fire()

                        end

                    end)

                    lastClickTime = now

                end

            end

        end)


    return connection

end


-- ============================================================
-- 领域触发函数 (自动匹配等级)
-- ============================================================

local function startDomain(towerType)

    local connection


    connection =
        RunService.Heartbeat:Connect(function()

            pcall(function()

                local tower = GetTower(towerType)

                if not tower then
                    return
                end


                -- 根据类型选择对应的远程事件
                local remote = nil

                if towerType == "KingOfCursesEvo" then

                    remote = KingDomain

                elseif towerType == "StrongestSorcererEvo" then

                    remote = GojoDomain

                elseif towerType == "JusticeSorcerer" then

                    remote = JusticeDomain

                end


                if remote and remote:IsA("RemoteEvent") then

                    remote:FireServer(tower)

                end

            end)

        end)


    return connection

end


